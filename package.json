{
  "name": "expo-hot-toast",
  "version": "0.1.0",
  "description": "react-hot-toast for Expo, with real Liquid Glass on iOS 26+ and themable design tokens.",
  "license": "MIT",
  "author": "VanitasCaesar1",
  "homepage": "https://github.com/VanitasCaesar1/expo-hot-toast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanitasCaesar1/expo-hot-toast.git"
  },
  "bugs": {
    "url": "https://github.com/VanitasCaesar1/expo-hot-toast/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "toast",
    "web",
    "react-hot-toast",
    "snackbar",
    "notification",
    "liquid-glass",
    "ios26",
    "glass-morphism",
    "reanimated",
    "gesture-handler"
  ],
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./src/index.ts"
      },
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./web": {
      "types": "./lib/web/types/web/index.d.ts",
      "import": "./lib/web/index.mjs",
      "require": "./lib/web/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "npm run test:logic && npm run test:components && npm run test:web",
    "test:logic": "vitest run",
    "test:components": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit --project example/tsconfig.json",
    "build": "bob build && npm run build:web",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "prepublishOnly": "npm run test && npm run typecheck",
    "build:web": "vite build -c vite.config.web.ts && tsc -p tsconfig.web.build.json && node scripts/web-types.mjs",
    "test:web": "vitest run -c vitest.web.config.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "web:example": "vite -c example-web/vite.config.ts"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": false
        }
      ],
      [
        "module",
        {
          "configFile": false,
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{__tests__,__fixtures__,__mocks__,web}/**"
  },
  "peerDependencies": {
    "expo-glass-effect": ">=55.0.0",
    "expo-haptics": ">=14.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^19.3.0",
    "expo": "~57.0.31",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "5.6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "expo-glass-effect": {
      "optional": true
    },
    "expo-haptics": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  }
}
