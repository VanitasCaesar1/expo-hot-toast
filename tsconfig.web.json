{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "noEmit": true,
    "paths": {
      "react-native": [
        "./src/web/shims/react-native.ts"
      ],
      "react-native-reanimated": [
        "./src/web/shims/reanimated.ts"
      ],
      "expo-glass-effect": [
        "./src/web/shims/expo-glass-effect.ts"
      ]
    },
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/web/**/*",
    "src/core/**/*",
    "src/theme/**/*",
    "src/utils/color.ts",
    "__tests__/web/**/*"
  ],
  "exclude": []
}
