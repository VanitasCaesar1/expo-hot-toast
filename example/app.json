{
  "expo": {
    "name": "expo-hot-toast example",
    "slug": "expo-hot-toast-example",
    "scheme": "expohottoast",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.expohottoast.example"
    },
    "android": {
      "package": "dev.expohottoast.example"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F2F2F7"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/expo-hot-toast/playground"
    }
  }
}
