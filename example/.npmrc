# Must match ../.npmrc, and be repeated here on purpose: npm reads .npmrc from
# the project it is invoked in, not from the parent directory. Verified — inside
# this directory `npm config get legacy-peer-deps` returns false with no file
# here, so the parent's setting does not reach this tree.
#
# The conflict is the same one: react-native-reanimated 4.7 requires
# react-native-worklets@0.13.x, while expo-modules-core@57.0.20 declares a stale
# *optional* peer capped at ^0.10.0. No version satisfies both, and expo-
# modules-core only peers on worklets optionally, so 0.13 costs it nothing.
legacy-peer-deps=true
