*.pem
*.cer
*.crt

# Generated native projects.
#
# This repo uses Expo's continuous native generation: `npx expo run:ios`
# prebuilds example/ios from example/app.json on demand. Committing the
# generated output would add ~1.2GB of CocoaPods to every clone, and it would
# drift out of date against app.json while looking authoritative.
example/ios/
example/android/
ios/
android/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment — no secrets belong in this repo, and nothing here needs one.
.env
.env.*
!.env.example

