---
import Head from '../components/Head.astro';
import SiteHeader from '../components/glass/SiteHeader';
import SiteSearch from '../components/glass/SiteSearch';
import Footer from '../components/Footer.astro';
import { url, REPO_URL } from '../lib/url';
import { loadDocs } from '../lib/docs';
import { buildStars } from '../lib/stars';

interface Props {
  title: string;
  description: string;
  /** Mount the real library over the page, for the live toast demos. */
  live?: boolean;
}

const { title, description, live = false } = Astro.props;
const inDocs = Astro.url.pathname.includes('/docs');
const stars = await buildStars();
const searchPages = loadDocs().map((p) => ({ title: p.title, group: p.group, url: url(`docs/${p.slug}`) }));
---

<!doctype html>
<html lang="en" data-theme="dark" data-lg-theme="dark" data-lg-mode="clear" data-lg-quality="medium">
  <head>
    <Head title={title} description={description} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader
      client:load
      home={url()}
      mark={url('mark.svg')}
      docs={url('docs')}
      changelog={`${REPO_URL}/blob/main/CHANGELOG.md`}
      repo={REPO_URL}
      inDocs={inDocs}
      stars={stars}
    />
    <main id="main" class="frame" tabindex="-1">
      <slot />
    </main>
    <Footer stars={stars} star={!live} />
    <SiteSearch client:idle base={url('pagefind/')} pages={searchPages} />
    {live && <div id="root" class="live-root"></div>}
    <script>
      // Sections settle into place as they arrive, once.
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            reveal.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => reveal.observe(el));
    </script>
  </body>
</html>
