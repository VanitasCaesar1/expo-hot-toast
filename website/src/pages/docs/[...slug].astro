---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { GROUPS, loadDocs, renderDocs } from '../../lib/docs';
import { pageMarkdown } from '../../lib/ai';
import { url, REPO_URL } from '../../lib/url';
import { GlassPanel } from '../../components/glassyui/glass-panel';
import CopyButton from '../../components/glass/CopyButton';
import LinkButton from '../../components/glass/LinkButton';

export async function getStaticPaths() {
  const pages = await renderDocs(loadDocs(), url('docs/'));
  return pages.flatMap((page, i) => {
    const props = { page, pages: pages.map(({ slug, title, group }) => ({ slug, title, group })), index: i };
    // The first page is also the docs landing page.
    return i === 0 ? [{ params: { slug: undefined }, props }, { params: { slug: page.slug }, props }] : [{ params: { slug: page.slug }, props }];
  });
}

const { page, pages, index } = Astro.props;
const groups = GROUPS;
const markdown = pageMarkdown(page.slug);
const prev = pages[index - 1];
const next = pages[index + 1];
---

<Base title={`${page.title}: expo-hot-toast docs`} description={page.description}>
  <div class="docs">
    <aside class="sidebar">
      <GlassPanel variant="card" className="sidebar-card">
      <nav aria-label="Docs">
        {
          groups.map((g) => (
            <section>
              <h2 class="label">{g}</h2>
              <ul>
                {pages
                  .filter((p) => p.group === g)
                  .map((p) => (
                    <li>
                      <a href={url(`docs/${p.slug}`)} aria-current={p.slug === page.slug ? 'page' : undefined}>
                        {p.title}
                      </a>
                    </li>
                  ))}
              </ul>
            </section>
          ))
        }
      </nav>
      </GlassPanel>
    </aside>

    <article class="prose" data-pagefind-body>
      <p class="label crumb">{page.group}</p>
      <h1 class="display">{page.title}</h1>
      {page.description && <p class="lede">{page.description}</p>}
      <div class="page-tools">
        <CopyButton text={markdown} label="Copy page" variant="soft" size="sm" />
        <LinkButton href={url(`docs/md/${page.slug}.md`)} label="Markdown" variant="soft" size="sm" />
        <LinkButton href={url('llms.txt')} label="llms.txt" variant="soft" size="sm" />
      </div>
      <Fragment set:html={page.html} />
      <footer class="pager">
        {prev ? (
          <a href={url(`docs/${prev.slug}`)}>
            <GlassPanel variant="card" interactive className="pager-card">
              <span class="label">Previous</span>
              {prev.title}
            </GlassPanel>
          </a>
        ) : <span />}
        {next && (
          <a class="next" href={url(`docs/${next.slug}`)}>
            <GlassPanel variant="card" interactive className="pager-card">
              <span class="label">Next</span>
              {next.title}
            </GlassPanel>
          </a>
        )}
      </footer>
      <a class="edit" href={`${REPO_URL}/blob/main/${page.source}`}>Edit this page on GitHub <Icon name="arrow-up-right" /></a>
    </article>

    <aside class="toc">
      {
        page.headings.length > 0 && (
          <nav aria-label="On this page">
            <h2 class="label">On this page</h2>
            <ul>
              {page.headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 264px minmax(0, 1fr) 200px;
  }
  .sidebar {
    padding: 24px 0 24px var(--pad);
  }
  .sidebar :global(.sidebar-card) {
    position: sticky;
    top: 96px;
  }
  .sidebar nav,
  .toc nav {
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    padding: 24px 20px;
  }
  .toc nav {
    position: sticky;
    top: 84px;
  }
  .sidebar section + section {
    margin-top: 28px;
  }
  aside h2 {
    margin: 0 0 12px;
    color: var(--faint);
  }
  aside ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .sidebar a {
    display: block;
    padding: 6px 12px;
    margin-inline: -12px;
    border-radius: 12px;
    color: var(--muted);
    font-size: 15px;
    text-decoration: none;
    transition:
      color 160ms,
      background 160ms;
  }
  .sidebar a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }
  .sidebar a[aria-current='page'] {
    color: var(--text);
    background: rgb(255 173 59 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(255 173 59 / 0.3);
  }
  /* The page tools are buttons, not prose links. */
  .prose .page-tools :global(a) {
    color: var(--text);
    text-decoration: none;
  }
  .toc a {
    display: block;
    padding: 4px 0;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--text);
  }

  .prose {
    min-width: 0;
    padding: 40px clamp(24px, 4vw, 64px) 72px;
    max-width: 820px;
  }
  .crumb {
    margin: 0 0 12px;
    color: var(--accent);
  }
  .prose h1 {
    margin: 0 0 14px;
    font-size: clamp(36px, 4vw, 52px);
  }
  /* The page's one-line summary, from its frontmatter. */
  .lede {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.5;
    max-width: 58ch;
  }
  .prose :global(h2) {
    margin: 52px 0 14px;
    font-family: var(--display);
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.02em;
    scroll-margin-top: 84px;
  }
  .prose :global(h3) {
    margin: 32px 0 10px;
    font-size: 19px;
    font-weight: 600;
    scroll-margin-top: 84px;
  }
  /* Copy the page as Markdown for an AI tool, or open it raw. */
  .page-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .prose :global(p),
  .prose :global(li) {
    color: color-mix(in srgb, var(--text) 82%, transparent);
    font-size: 16.5px;
    line-height: 1.7;
    max-width: 68ch;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.38em;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.86em;
  }
  .prose :global(pre) {
    margin: 22px 0;
    padding: 18px 20px;
    overflow-x: auto;
    /* Markdown renders plain <pre>, so code takes the glass card's frost here. */
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 18px;
    background: rgb(14 14 13 / 0.62) !important;
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
    font-size: 14px;
    line-height: 1.6;
  }
  .prose :global(table) {
    width: 100%;
    margin: 22px 0;
    border-collapse: collapse;
    font-size: 14.5px;
    display: block;
    overflow-x: auto;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 16px;
    background: rgb(14 14 13 / 0.45);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }
  /*
   * Name, type and default stay on one line; the description column wraps.
   * Code in tables is plain monospace, not boxed: a box in every cell is noise.
   */
  .prose :global(td:nth-child(-n + 3)) {
    white-space: nowrap;
  }
  .prose :global(td code) {
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.86em;
    color: var(--muted);
  }
  .prose :global(td:first-child code) {
    color: var(--text);
  }
  .prose :global(th) {
    background: var(--surface);
    font-weight: 600;
    color: var(--text);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 64px;
  }
  .pager a {
    color: var(--text);
    text-decoration: none;
    font-size: 17px;
  }
  .pager :global(.pager-card) {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 18px 22px;
  }
  .pager .label {
    color: var(--faint);
  }
  .pager .next {
    text-align: right;
  }
  .edit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    color: var(--muted) !important;
    font-size: 14px;
  }

  @media (max-width: 1100px) {
    .docs {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    /* On a phone the header's search lists every page, so the sidebar goes. */
    .sidebar {
      display: none;
    }
    .sidebar :global(.sidebar-card) {
      position: static;
    }
    .sidebar nav {
      max-height: none;
      padding: 20px var(--pad);
      display: flex;
      gap: 24px;
      overflow-x: auto;
    }
    .sidebar section + section {
      margin-top: 0;
    }
    .sidebar ul {
      grid-auto-flow: column;
    }
  }
</style>
