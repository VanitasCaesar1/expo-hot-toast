---
import DocsLayout from '../../layouts/DocsLayout.astro';
import PageActions from '../../components/docs/PageActions.astro';
import Toc from '../../components/docs/Toc.astro';
import Feedback from '../../components/docs/Feedback.astro';
import Icon from '../../components/Icon.astro';
import { TABS, loadDocs, renderDocs, tabOf } from '../../lib/docs';
import { pageMarkdown } from '../../lib/ai';
import { url, REPO_URL } from '../../lib/url';

export async function getStaticPaths() {
  const pages = await renderDocs(loadDocs(), url('docs/'));
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const tab = TABS.find((t) => t.id === tabOf(page.group))!;
const markdown = pageMarkdown(page.slug);
const updated = page.updated
  ? new Date(`${page.updated}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
  : undefined;
---

<DocsLayout title={`${page.title}: expo-hot-toast docs`} description={page.description} current={page.slug}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={tab.id === 'guides' ? url('docs') : url(`docs/${page.slug}`)}>{tab.label}</a>
    <span aria-hidden="true">/</span>
    <span>{page.group === tab.label ? page.title : page.group}</span>
  </nav>
  <h1>{page.title}</h1>
  <PageActions slug={page.slug} title={page.title} markdown={markdown} />
  {page.description && <p class="lede">{page.description}</p>}

  <div class:list={['prose', { stepped: page.steps }]}>
    <Fragment set:html={page.html} />
  </div>

  <Feedback title={page.title} slug={page.slug} />

  <div class="page-meta">
    {updated && <p>Last updated on {updated}</p>}
    <a href={`${REPO_URL}/blob/main/${page.source}`} target="_blank" rel="noopener">
      <Icon name="github" /> Edit on GitHub <Icon name="arrow-up-right" />
    </a>
  </div>

  <Fragment slot="aside">
    <Toc headings={page.headings} steps={page.steps} />
    <a class="aside-card" href={url('#try')}>
      <span class="aside-card-title"><Icon name="play-circle" /> See it live</span>
      <span>Every call on these pages fires a real toast on the home page.</span>
    </a>
  </Fragment>
</DocsLayout>
