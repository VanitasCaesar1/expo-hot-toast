---
import Base from '../layouts/Base.astro';
import ScreenCrop from '../components/ScreenCrop.astro';
import DemoWindow from '../components/DemoWindow.astro';
import HeroToast from '../components/live/HeroToast';
import Examples from '../components/live/Examples';
import PositionPicker from '../components/live/Position';
import Customiser from '../components/live/Customiser';
import LinkButton from '../components/glass/LinkButton';
import CopyButton from '../components/glass/CopyButton';
import CommandBox from '../components/glass/CommandBox';
import Faq from '../components/glass/Faq';
import StarButton from '../components/glass/StarButton';
import { buildStars } from '../lib/stars';
import { GlassPanel } from '../components/glassyui/glass-panel';
import { GlassBadge } from '../components/glassyui/glass-badge';
import Icon from '../components/Icon.astro';
import CodePanel from '../components/CodePanel.astro';
import { url, INSTALL, REPO_URL } from '../lib/url';
import { SETUP_PROMPT } from '../lib/ai';

const stars = await buildStars();

const migrate = `- import toast, { Toaster } from 'react-hot-toast';
+ import toast, { Toaster } from 'expo-hot-toast';`;

const setup = `import { Toaster, toast } from 'expo-hot-toast';

export default function App() {
  return (
    <>
      <Home />
      <Toaster />
    </>
  );
}

toast.success('Changes saved');`;

// Each feature leads with the line of API it is about.
const features = [
  { spec: 'visibleToasts: 3', title: 'A queue, not a pile', body: 'Three show per edge. The rest wait their turn, and each gets its full time once it is on screen.' },
  { spec: 'swipe · press and hold', title: 'Swipe it away, hold to read', body: 'Fling a toast to dismiss it. Press and hold one to pause every timer in the stack.' },
  { spec: "dedupeKey: 'draft'", title: 'Twenty calls, one toast', body: 'Repeat a call with the same key while its toast is showing and you get that toast back, not a second copy.' },
  { spec: 'VoiceOver · TalkBack', title: 'Accessible by default', body: 'Announced to screen readers, with Reduce Motion, Reduce Transparency, capped font scaling and a haptic per type.' },
  { spec: 'iconPop · iconPopDelay', title: 'The check draws itself', body: 'Icons pop in and the checkmark draws on react-hot-toast’s timing. Under Reduce Motion they arrive finished.' },
  { spec: 'theme={{ radius: 14 }}', title: 'Tokens, not overrides', body: 'Light and dark defaults follow the system. Every token is overridable, and exports as a CSS variable for NativeWind or Unistyles.' },
];

const faq = [
  {
    q: 'Can I use react-hot-toast itself in Expo?',
    a: 'No. react-hot-toast renders DOM elements, so it only runs on the web (including Expo web). This package rebuilds its API on native views: toast, toast.promise, <Toaster>, <ToastBar>, iconTheme and useToaster work as you know them. className and ariaProps have React Native equivalents instead, and a stack shows three toasts at a time rather than twenty.',
  },
  {
    q: 'What do Android and older iOS get?',
    a: 'An opaque surface with real colour, border and shadow, in light and dark. The same surface is used on iOS 26 when Reduce Transparency is on. On the web, browsers that can blur a backdrop get frosted glass instead, the toasts you can fire on this page.',
  },
  {
    q: 'Does it work on the web?',
    a: 'Yes, through React Native Web, as in Expo web apps. Every toast on this page is the library running that way. Liquid Glass is UIKit’s, so browsers get frosted glass: a backdrop blur under a translucent fill, tuned by the frostBlur, frostSaturation and frostHighlight tokens, and opaque for anyone who prefers reduced transparency.',
  },
  {
    q: 'What does Liquid Glass need?',
    a: 'An app built with the iOS 26 SDK (Xcode 26 or newer), running on iOS 26. Glass comes from expo-glass-effect, which wraps the native UIGlassEffect.',
  },
  {
    q: 'Can toasts show above a modal?',
    a: 'Native modals cover the rest of the app. On iOS, pass FullWindowOverlay from react-native-screens as the Toaster’s ContainerComponent and toasts stay on top.',
  },
  {
    q: 'Is it on npm?',
    a: 'Not yet. Install it from GitHub for now; npm builds the package after cloning.',
  },
];
---

<Base
  title="expo-hot-toast: toasts for Expo, in real Liquid Glass"
  description="The react-hot-toast API for Expo and React Native, drawn with Apple's own Liquid Glass on iOS 26, frosted glass on the web and a designed surface on Android."
  live
>
  <section class="hero">
    <div class="hero-copy inset">
      <p class="label eyebrow enter" style="--i: 0">Open source for Expo and React Native</p>
      <h1 class="display enter" style="--i: 1">Toasts in real Liquid Glass.</h1>
      <p class="lede enter" style="--i: 2">The react-hot-toast API, drawn with Apple's own material on iOS 26, frosted glass on the web and a designed surface on Android.</p>
      <div class="ctas enter" style="--i: 3">
        <HeroToast client:load />
        <LinkButton client:visible href={url('docs/installation')} label="Quick start" trailing="arrow-right" variant="primary" size="lg" />
      </div>
      <button type="button" class="ai-link enter" style="--i: 4" data-copy={SETUP_PROMPT}>
        <span class="idle-label">Using an AI agent? Copy a setup prompt <Icon name="copy" /></span>
        <span class="done-label">Prompt copied. Paste it into your agent.</span>
      </button>
    </div>
    <div class="hero-devices">
      <div class="glow" aria-hidden="true"></div>
      <div class="field dots" aria-hidden="true"></div>
      <div class="shot">
        <ScreenCrop media="ios-demo" label="Toasts stacking in Liquid Glass at the top of an iPhone running iOS 26" loopEnd={19.6} />
        <p class="label caption">Screen recording · iOS 26 simulator in CI</p>
      </div>
    </div>
  </section>

  <section class="proof inset" aria-label="How it is checked">
    {
      [
        { stat: '350+', body: 'Tests across logic and components, on every change.' },
        { stat: 'iOS 26', body: 'The example app runs on an iOS 26 simulator in CI.' },
        { stat: 'Android', body: 'And on an Android emulator, every row driven by Maestro.' },
        { stat: 'Web', body: 'Built for the web in CI. Every toast on this page runs on it.' },
      ].map((p, i) => (
        <div data-reveal style={`--i: ${i}`}>
          <GlassPanel variant="card" className="stat-card">
            <span class="display stat">{p.stat}</span>
            <p>{p.body}</p>
          </GlassPanel>
        </div>
      ))
    }
  </section>

  <section class="band live" aria-labelledby="try">
    <header class="head inset" data-reveal>
      <h2 id="try" class="display">Go on, make a toast.</h2>
      <p>Every button fires a real toast over this page: the library itself, running in your browser. Swipe one away, or press and hold to pause it.</p>
    </header>
    <div class="live-stage">
      <Examples client:visible />
    </div>
  </section>

  <section class="band live" aria-labelledby="where">
    <header class="head inset" data-reveal>
      <h2 id="where" class="display">Put it anywhere.</h2>
      <p>Six positions, and the stack can grow either way. This page's toasts move as you pick.</p>
    </header>
    <div class="live-stage mirrored" style="min-height: 300px">
      <PositionPicker client:only="react" />
    </div>
  </section>

  <section class="band live" aria-labelledby="yours">
    <header class="head inset" data-reveal>
      <h2 id="yours" class="display">Make it yours.</h2>
      <p>Every colour, size and duration is a token. Change them here, watch the toasts on this page follow, and copy the Toaster you built.</p>
    </header>
    <div class="live-stage low" style="min-height: 560px">
      <Customiser client:only="react" />
    </div>
  </section>

  <section class="band" aria-labelledby="calls">
    <header class="head inset" data-reveal>
      <h2 id="calls" class="display">On iPhone, it's real Liquid Glass.</h2>
      <p>A browser can only frost. On iOS 26 the same calls draw Apple's own material. These are screen recordings from CI, not mockups: pick a call to jump to it.</p>
    </header>
    <DemoWindow />
  </section>

  <section class="band" aria-labelledby="built">
    <header class="head inset" data-reveal>
      <h2 id="built" class="display">Built for a phone, not ported to one.</h2>
    </header>
    <div class="features inset">
      {
        features.map((f, i) => (
          <div data-reveal style={`--i: ${i % 3}`}>
            <GlassPanel variant="card" className="feature" interactive>
              <GlassBadge tone="orange" className="spec">{f.spec}</GlassBadge>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </GlassPanel>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band migrate inset" aria-labelledby="migrate">
    <div class="migrate-copy">
      <h2 id="migrate" class="display">Know <span class="nowrap">react-hot-toast</span> from the web?</h2>
      <p>It renders to the DOM, so it cannot run in an Expo or React Native app. This is its API rebuilt on native views: the calls you write on the web work here, and <a href={url('docs/coming-from-react-hot-toast')}>the differences fit on one page</a>.</p>
    </div>
    <div class="diff" data-reveal>
      <CodePanel code={migrate} lang="diff" file="Porting a web screen" />
    </div>
  </section>

  <section class="band" aria-labelledby="faq">
    <header class="head inset" data-reveal>
      <h2 id="faq" class="display">Questions</h2>
    </header>
    <div class="faq inset">
      <Faq client:visible items={faq} />
    </div>
  </section>

  <section class="band start" aria-labelledby="start">
    <div class="start-inner inset">
      <h2 id="start" class="display huge" data-reveal>Ship your first toast.</h2>
      <div class="start-grid">
        <div class="by-hand">
          <p class="label">By hand</p>
          <CommandBox client:visible command={INSTALL} />
          <div class="setup">
            <CodePanel code={setup} lang="tsx" file="App.tsx" />
          </div>
          <LinkButton client:visible href={url('docs/installation')} label="Quick start" trailing="arrow-right" variant="prominent" size="lg" />
        </div>
        <div class="by-agent">
          <p class="label">With an AI agent</p>
          <p>Paste this into Claude Code, Cursor or Codex. It installs the package and its peers, wires the app root and swaps your toasts, using the full docs as plain text.</p>
          <GlassPanel variant="card" className="prompt-card">
            <pre class="prompt-preview" aria-label="The setup prompt">{SETUP_PROMPT}</pre>
          </GlassPanel>
          <CopyButton client:visible text={SETUP_PROMPT} label="Copy prompt" variant="primary" size="lg" />
          <p class="llms">
            For tools that read docs: <a href={url('llms.txt')}>llms.txt</a> · <a href={url('llms-full.txt')}>llms-full.txt</a>
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="star inset" aria-labelledby="star">
    <GlassPanel variant="card" className="star-card">
      <div>
        <h2 id="star" class="display">Like it? Give it a star.</h2>
        <p>It is free and MIT licensed. Stars are how other Expo developers find it, and the best way to say it saved you an afternoon.</p>
      </div>
      <div class="star-actions">
        <StarButton client:visible repo={REPO_URL} initial={stars} label="Star on GitHub" variant="prominent" size="lg" />
        <LinkButton client:visible href={`${REPO_URL}/issues`} label="Report an issue" variant="soft" size="lg" />
      </div>
    </GlassPanel>
  </section>
</Base>

<script>
  // Recordings play only while on screen, and never under Reduce Motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const seen = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting && !reduce.matches && v.offsetParent !== null) void v.play().catch(() => {});
        else v.pause();
      }
    },
    { threshold: 0.35 },
  );
  document.querySelectorAll('video').forEach((v) => seen.observe(v));

  // A clip with data-loop-end restarts there instead of at its end.
  document.querySelectorAll<HTMLVideoElement>('video[data-loop-end]').forEach((v) => {
    const end = Number(v.dataset.loopEnd);
    v.addEventListener('timeupdate', () => {
      if (v.currentTime >= end) v.currentTime = 0;
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-height: min(calc(100dvh - 84px), 760px);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 56px;
  }
  .eyebrow {
    margin: 0 0 22px;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(44px, 6vw, 80px);
    max-width: 11ch;
  }
  .lede {
    margin: 24px 0 0;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--muted);
    max-width: 36ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 36px;
  }
  /* Staged entrance: label, headline, text, buttons, then the phone. */
  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation: settle 800ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .hero-devices {
    position: relative;
    display: grid;
    place-items: center;
    padding: 32px var(--pad);
    overflow: hidden;
  }
  /* Warm light under the phone: the 'hot' in hot toast. Tinted, not neon. */
  .glow {
    position: absolute;
    left: 50%;
    top: 55%;
    width: 760px;
    height: 760px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgb(255 173 59 / 0.2), rgb(255 173 59 / 0.07) 38%, transparent 68%);
    pointer-events: none;
  }
  .shot {
    position: relative;
    width: 100%;
    max-width: 560px;
    animation: rise 1000ms 250ms var(--ease-out) both;
  }
  .caption {
    margin: 4px 0 0;
    color: var(--faint);
    text-align: center;
  }
  @keyframes rise {
    from {
      transform: translateY(28px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot {
      animation: none;
    }
  }

  /* Four glass cards: how the library is checked. */
  .proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .proof :global(.stat-card) {
    height: 100%;
    padding: 24px 24px 26px;
  }
  .stat {
    display: block;
    font-size: clamp(30px, 3vw, 40px);
    color: var(--text);
  }
  .proof p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 30ch;
  }

  .head {
    padding-block: 96px 36px;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 48px);
    max-width: 20ch;
  }
  .head p {
    margin: 14px 0 0;
    color: var(--muted);
    max-width: 58ch;
  }

  /* Six glass cards: the API line, the name, one sentence. */
  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .features > div {
    min-width: 0;
  }
  .features :global(.feature) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 26px 26px 30px;
  }
  .features :global(.spec) {
    align-self: flex-start;
    margin-bottom: 8px;
    font-family: var(--mono);
    font-size: 12.5px;
    white-space: nowrap;
  }
  h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .features p {
    margin: 0;
    color: var(--muted);
    max-width: 34ch;
  }

  .migrate {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding-top: 112px;
  }
  .migrate p {
    margin: 14px 0 0;
    color: var(--muted);
    max-width: 44ch;
  }
  .migrate a {
    color: var(--accent);
  }

  .faq {
    max-width: 920px;
  }

  .start-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    justify-items: start;
    padding-block: 112px 96px;
  }
  .start-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 56px);
    width: 100%;
  }
  .by-hand,
  .by-agent {
    display: grid;
    /* A code block's lines must scroll inside it, not widen the column. */
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    align-content: start;
    min-width: 0;
  }
  .by-hand :global(.lg-button),
  .by-agent :global(.lg-button) {
    justify-self: start;
  }
  .by-hand :global(.command-box .lg-button) {
    justify-self: auto;
  }
  .by-hand .label,
  .by-agent .label {
    margin: 0;
    color: var(--accent);
  }
  .by-agent > p:not(.label) {
    margin: 0;
    color: var(--muted);
    max-width: 46ch;
  }
  /* The prompt itself, shown so nobody pastes something they have not read. */
  .prompt-preview {
    max-height: 236px;
    margin: 0;
    padding: 18px 20px;
    overflow: auto;
    color: var(--muted);
    font: 12.5px/1.6 var(--mono);
    white-space: pre-wrap;
    mask-image: linear-gradient(#000 78%, transparent);
    -webkit-mask-image: linear-gradient(#000 78%, transparent);
  }
  .by-agent .llms {
    margin: 0;
    color: var(--faint);
    font-size: 14px;
  }
  .by-agent .llms a {
    color: var(--muted);
  }
  .ai-link {
    align-self: flex-start;
    margin-top: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 14.5px;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: rgb(255 173 59 / 0.5);
    text-underline-offset: 4px;
  }
  .ai-link:hover {
    color: var(--text);
  }
  .ai-link span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ai-link .done-label,
  .ai-link[data-copied] .idle-label {
    display: none;
  }
  .ai-link[data-copied] .done-label {
    display: inline-flex;
    color: var(--accent);
  }
  .star :global(.star-card) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 48px;
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
  }
  .star h2 {
    font-size: clamp(28px, 3vw, 40px);
  }
  .star p {
    margin: 12px 0 0;
    max-width: 52ch;
    color: var(--muted);
  }
  .star-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .huge {
    font-size: clamp(52px, 8.6vw, 124px);
    max-width: 12ch;
    line-height: 0.96;
    margin-bottom: 12px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .migrate,
    .start-grid,
    .star :global(.star-card) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
