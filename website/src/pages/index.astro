---
import Base from '../layouts/Base.astro';
import DemoWindow from '../components/DemoWindow.astro';
import HeroToast from '../components/live/HeroToast';
import Examples from '../components/live/Examples';
import PositionPicker from '../components/live/Position';
import Customiser from '../components/live/Customiser';
import LinkButton from '../components/glass/LinkButton';
import Faq from '../components/glass/Faq';
import Features from '../components/home/Features.astro';
import Migrate from '../components/home/Migrate.astro';
import Start from '../components/home/Start.astro';
import Rich from '../components/home/Rich.astro';
import StarButton from '../components/glass/StarButton';
import { buildStars } from '../lib/stars';
import { GlassPanel } from '../components/glassyui/glass-panel';
import Icon from '../components/Icon.astro';
import { url, REPO_URL } from '../lib/url';
import { SETUP_PROMPT } from '../lib/ai';

const stars = await buildStars();





const faq = [
  {
    q: 'Can I use react-hot-toast itself in Expo?',
    a: 'No. react-hot-toast renders DOM elements, so it only runs on the web (including Expo web). This package rebuilds its API on native views: toast, toast.promise, <Toaster>, <ToastBar>, iconTheme and useToaster work as you know them. className and ariaProps have React Native equivalents instead, and a stack shows three toasts at a time rather than twenty.',
  },
  {
    q: 'What do Android and older iOS get?',
    a: 'Android gets a Material 3 snackbar by default, as its own apps do: the inverse surface, near-square corners, rising from the bottom. Older iOS gets an opaque pill with real colour, border and shadow, in light and dark, as does iOS 26 when Reduce Transparency is on. preset="glass" uses the pill everywhere. On the web, browsers that can blur a backdrop get frosted glass instead, the toasts you can fire on this page.',
  },
  {
    q: 'Does it work on the web?',
    a: 'Yes, through React Native Web, as in Expo web apps. Every toast on this page is the library running that way. Liquid Glass is UIKit’s, so browsers get frosted glass: a backdrop blur under a translucent fill, tuned by the frostBlur, frostSaturation and frostHighlight tokens, and opaque for anyone who prefers reduced transparency.',
  },
  {
    q: 'What does Liquid Glass need?',
    a: 'An app built with the iOS 26 SDK (Xcode 26 or newer), running on iOS 26. Glass comes from expo-glass-effect, which wraps the native UIGlassEffect.',
  },
  {
    q: 'Can toasts show above a modal?',
    a: 'Native modals cover the rest of the app. On iOS, pass FullWindowOverlay from react-native-screens as the Toaster’s ContainerComponent and toasts stay on top.',
  },
  {
    q: 'Is it on npm?',
    a: 'Not yet. Install it from GitHub for now; npm builds the package after cloning.',
  },
];
---

<Base
  title="expo-hot-toast: toasts for Expo, in real Liquid Glass"
  description="The react-hot-toast API for Expo and React Native, drawn with Apple's own Liquid Glass on iOS 26, frosted glass on the web and a designed surface on Android."
  live
>
  <section class="hero inset">
    <div class="hero-copy">
      <p class="label eyebrow enter" style="--i: 0">Open source for Expo and React Native</p>
      <h1 class="display enter" style="--i: 1">Toasts in real <span class="nowrap">Liquid Glass.</span></h1>
      <p class="lede enter" style="--i: 2">The react-hot-toast API, drawn with Apple's own material on iOS 26, frosted glass on the web and a designed surface on Android.</p>
      <div class="ctas enter" style="--i: 3">
        <HeroToast client:load />
        <LinkButton href={url('docs/installation')} label="Quick start" trailing="arrow-right" variant="primary" size="lg" />
      </div>
      <button type="button" class="ai-link enter" style="--i: 4" data-copy={SETUP_PROMPT}>
        <span class="idle-label">Using an AI agent? Copy a setup prompt <Icon name="copy" /></span>
        <span class="done-label">Prompt copied. Paste it into your agent.</span>
      </button>
    </div>

    <figure class="hero-stage enter" style="--i: 5">
      <div class="stage-art" aria-hidden="true">
        <span class="ribbon one"></span>
        <span class="ribbon two"></span>
        <span class="ember a"></span>
        <span class="ember b"></span>
      </div>
      <div class="stage-toasts" data-toast-stage></div>
      <figcaption class="stage-caption">
        <span class="live-dot" aria-hidden="true"></span>
        Live: the library itself, running in your browser. <a href="#calls">See real Liquid Glass on iPhone ↓</a>
      </figcaption>
    </figure>
  </section>

  <section aria-labelledby="more">
    <header class="head inset" data-reveal>
      <h2 id="more" class="display">More than a line of text.</h2>
      <p>Uploads, steps, Undo with a countdown, notifications, a HUD and the island. Each is one call, and each tile is the library itself, playing on this page.</p>
      <a class="head-link" href={url('docs/rich-toasts')}>Rich toasts guide <Icon name="arrow-right" /></a>
    </header>
    <Rich />
  </section>

  <section class="band live" aria-labelledby="try">
    <header class="head inset" data-reveal>
      <h2 id="try" class="display">Go on, make a toast.</h2>
      <p>Every button fires a real toast over this page: the library itself, running in your browser. Swipe one away, or press and hold to pause it.</p>
    </header>
    <div class="live-stage">
      <Examples client:visible />
    </div>
  </section>

  <section class="band live" aria-labelledby="where">
    <header class="head inset" data-reveal>
      <h2 id="where" class="display">Put it anywhere.</h2>
      <p>Six positions, and the stack can grow either way. This page's toasts move as you pick.</p>
    </header>
    <div class="live-stage mirrored" style="min-height: 300px">
      <PositionPicker client:only="react" />
    </div>
  </section>

  <section class="band live" aria-labelledby="yours">
    <header class="head inset" data-reveal>
      <h2 id="yours" class="display">Make it yours.</h2>
      <p>Every colour, size and duration is a token. Change them here, watch the toasts on this page follow, and copy the Toaster you built.</p>
    </header>
    <div class="live-stage low" style="min-height: 560px">
      <Customiser client:only="react" />
    </div>
  </section>

  <section class="band" aria-labelledby="calls">
    <header class="head inset" data-reveal>
      <h2 id="calls" class="display">On iPhone, it's real Liquid Glass.</h2>
      <p>A browser can only frost. On iOS 26 the same calls draw Apple's own material. These are screen recordings from CI, not mockups: pick a call to jump to it.</p>
    </header>
    <DemoWindow />
  </section>

  <section aria-labelledby="built">
    <header class="head inset" data-reveal>
      <h2 id="built" class="display">Built for a phone, not ported to one.</h2>
      <p>Every tile is the library itself, running on this page. Try them.</p>
    </header>
    <Features />
  </section>

  <section aria-labelledby="migrate">
    <Migrate />
  </section>

  <section class="faq inset" aria-labelledby="faq">
    <header>
      <h2 id="faq" class="display">Questions</h2>
      <p>Something else? <a href={`${REPO_URL}/issues`}>Ask on GitHub</a>.</p>
    </header>
    <Faq client:visible items={faq} />
  </section>

  <section aria-labelledby="start">
    <Start />
  </section>
  <section class="star inset" aria-labelledby="star">
    <GlassPanel variant="card" className="star-card">
      <div>
        <h2 id="star" class="display">Like it? Give it a star.</h2>
        <p>It is free and MIT licensed. Stars are how other Expo developers find it, and the best way to say it saved you an afternoon.</p>
      </div>
      <div class="star-actions">
        <StarButton client:visible repo={REPO_URL} initial={stars} label="Star on GitHub" variant="prominent" size="lg" />
        <LinkButton href={`${REPO_URL}/issues`} label="Report an issue" variant="soft" size="lg" />
      </div>
    </GlassPanel>
  </section>
</Base>

<script>
  // Recordings play only while on screen, and never under Reduce Motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const seen = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting && !reduce.matches && v.offsetParent !== null) void v.play().catch(() => {});
        else v.pause();
      }
    },
    { threshold: 0.35 },
  );
  document.querySelectorAll('video').forEach((v) => seen.observe(v));

  // A clip with data-loop-end restarts there instead of at its end.
  document.querySelectorAll<HTMLVideoElement>('video[data-loop-end]').forEach((v) => {
    const end = Number(v.dataset.loopEnd);
    v.addEventListener('timeupdate', () => {
      if (v.currentTime >= end) v.currentTime = 0;
    });
  });
</script>

<style>
  /* A centred headline over the stage, where the library plays live. */
  .hero {
    display: grid;
    gap: clamp(28px, 3.4vw, 44px);
    padding-block: clamp(24px, 3.4vw, 44px) 24px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 18px;
    color: var(--accent-text);
  }
  /* One line on a laptop, so the stage shows on arrival. */
  h1 {
    margin: 0;
    font-size: clamp(44px, 5.6vw, 80px);
  }
  .lede {
    margin: 18px 0 0;
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--muted);
    max-width: 58ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }
  /* Staged entrance: label, headline, text, buttons, then the stage. */
  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation: settle 800ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /*
   * The stage: warm liquid light, moving slowly, under the stage Toaster
   * (toasterId "stage"). The toasts' frosted glass blurs and bends it, which is
   * the whole point of putting colour here.
   */
  .hero-stage {
    position: relative;
    margin: 0;
    height: clamp(340px, 34vw, 440px);
    border-radius: 36px;
    overflow: hidden;
    background: var(--stage-base);
    box-shadow:
      inset 0 0 0 1px var(--hairline),
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 50px 120px -50px rgb(255 120 30 / 0.45);
  }
  .stage-art,
  .stage-toasts {
    position: absolute;
    inset: 0;
  }
  .ribbon {
    position: absolute;
    inset: -20% -10%;
    background: url('/expo-hot-toast/media/ribbon.svg') center / cover no-repeat;
    animation: drift 22s ease-in-out infinite alternate;
  }
  .ribbon.two {
    inset: -30% -20%;
    opacity: 0.55;
    transform: scale(-1, 1) rotate(8deg);
    animation-duration: 28s;
    animation-direction: alternate-reverse;
  }
  .ember {
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(60px);
    animation: float 18s ease-in-out infinite alternate;
  }
  .ember.a {
    left: 8%;
    top: -18%;
    background: rgb(255 120 40 / 0.55);
  }
  .ember.b {
    right: 4%;
    bottom: -30%;
    background: rgb(214 45 74 / 0.45);
    animation-duration: 24s;
  }
  @keyframes drift {
    from {
      transform: translate3d(-4%, 3%, 0) rotate(-3deg);
    }
    to {
      transform: translate3d(4%, -3%, 0) rotate(3deg);
    }
  }
  @keyframes float {
    to {
      transform: translate3d(12%, 10%, 0);
    }
  }
  /* Off screen, under Reduce Motion, or once the page is hidden: still. */
  .hero-stage[data-offscreen] :is(.ribbon, .ember) {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .ribbon,
    .ember {
      animation: none;
    }
  }
  .stage-caption {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 8px 16px;
    border-radius: 999px;
    /* A plain tint: a blur here would redraw over the moving art every frame. */
    background: var(--caption-bg);
    color: var(--caption-text);
    font-size: 13.5px;
  }
  .stage-caption a {
    color: var(--accent-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff6b3d;
    box-shadow: 0 0 0 4px rgb(255 107 61 / 0.2);
  }

  .head {
    padding-block: 96px 36px;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 48px);
    max-width: 20ch;
  }
  .head p {
    margin: 14px 0 0;
    color: var(--muted);
    max-width: 58ch;
  }
  .head-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    color: var(--accent-text);
    font-weight: 500;
    text-decoration: none;
  }
  .head-link:hover {
    text-decoration: underline;
  }

  /* The heading beside one glass card of questions. */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
    padding-top: 112px;
  }
  .faq header p {
    margin: 14px 0 0;
    color: var(--muted);
  }
  .faq header a {
    color: var(--accent-text);
  }

  .ai-link {
    align-self: center;
    margin-top: 14px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 14.5px;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--accent-ring);
    text-underline-offset: 4px;
  }
  .ai-link:hover {
    color: var(--text);
  }
  .ai-link span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ai-link .done-label,
  .ai-link[data-copied] .idle-label {
    display: none;
  }
  .ai-link[data-copied] .done-label {
    display: inline-flex;
    color: var(--accent-text);
  }
  /* The star card continues the start section above it, so it shares that
     section's centred 920px column rather than the full page width. */
  .star {
    margin-top: 20px;
  }
  .star :global(.star-card) {
    max-width: 920px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 48px;
    align-items: center;
    padding: clamp(28px, 4vw, 48px);
  }
  .star h2 {
    font-size: clamp(28px, 3vw, 40px);
  }
  .star p {
    margin: 12px 0 0;
    max-width: 52ch;
    color: var(--muted);
  }
  .star-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 960px) {
    .faq,
    .star :global(.star-card) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .hero-stage {
      height: 360px;
      border-radius: 26px;
    }
    .stage-caption a {
      display: none;
    }
  }
</style>
