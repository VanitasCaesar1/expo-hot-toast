---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import ScreenCrop from '../components/ScreenCrop.astro';
import DemoWindow from '../components/DemoWindow.astro';
import CopyInstall from '../components/CopyInstall.astro';
import Icon from '../components/Icon.astro';
import CodePanel from '../components/CodePanel.astro';
import { url } from '../lib/url';

const migrate = `- import toast, { Toaster } from 'react-hot-toast';
+ import toast, { Toaster } from 'expo-hot-toast';`;

const setup = `import { Toaster, toast } from 'expo-hot-toast';

export default function App() {
  return (
    <>
      <Home />
      <Toaster />
    </>
  );
}

toast.success('Changes saved');`;

const stills = [
  { media: 'ios-stack-dark', label: 'iOS 26, dark', alt: 'Toasts on Liquid Glass in dark mode on iOS 26' },
  { media: 'ios-stack-light', label: 'iOS 26, light', alt: 'Toasts on Liquid Glass in light mode on iOS 26' },
  { media: 'android-stack-dark', label: 'Android, dark', alt: 'Toasts on the opaque surface in dark mode on Android' },
  { media: 'android-stack-light', label: 'Android, light', alt: 'Toasts on the opaque surface in light mode on Android' },
];

const faq = [
  {
    q: 'Is it a drop-in for react-hot-toast?',
    a: 'Mostly. toast, toast.promise, <Toaster>, <ToastBar>, iconTheme and useToaster work as you know them. className and ariaProps have React Native equivalents instead, and a stack shows three toasts at a time rather than twenty.',
  },
  {
    q: 'What do Android and older iOS get?',
    a: 'An opaque surface with real colour, border and shadow, in light and dark. The same surface is used on iOS 26 when Reduce Transparency is on. Nothing imitates glass where the platform does not draw it.',
  },
  {
    q: 'What does Liquid Glass need?',
    a: 'An app built with the iOS 26 SDK (Xcode 26 or newer), running on iOS 26. Glass comes from expo-glass-effect, which wraps the native UIGlassEffect.',
  },
  {
    q: 'Can toasts show above a modal?',
    a: 'Native modals cover the rest of the app. On iOS, pass FullWindowOverlay from react-native-screens as the Toaster’s ContainerComponent and toasts stay on top.',
  },
  {
    q: 'Is it on npm?',
    a: 'Not yet. Install it from GitHub for now; npm builds the package after cloning.',
  },
];
---

<Base
  title="expo-hot-toast: toasts for Expo, in real Liquid Glass"
  description="The react-hot-toast API for Expo and React Native, drawn with Apple's own Liquid Glass on iOS 26 and a designed surface on Android."
>
  <section class="hero">
    <div class="hero-copy inset">
      <p class="label eyebrow enter" style="--i: 0">Open source for Expo and React Native</p>
      <h1 class="display enter" style="--i: 1">Toasts in real Liquid Glass.</h1>
      <p class="lede enter" style="--i: 2">The react-hot-toast API, drawn with Apple's own material on iOS 26 and a designed surface on Android.</p>
      <div class="ctas enter" style="--i: 3">
        <a class="button primary" href={url('docs/installation')}>Quick start <Icon name="arrow-right" /></a>
        <CopyInstall />
      </div>
    </div>
    <div class="hero-devices">
      <div class="glow" aria-hidden="true"></div>
      <div class="field dots" aria-hidden="true"></div>
      <div class="shot">
        <ScreenCrop media="ios-demo" label="Toasts stacking in Liquid Glass at the top of an iPhone running iOS 26" loopEnd={20.5} />
        <p class="label caption">Screen recording · iOS 26 simulator in CI</p>
      </div>
    </div>
  </section>

  <section class="band platforms" aria-label="Built for">
    <span title="Expo"><Icon name="expo" label="Expo" /></span>
    <span title="React Native"><Icon name="react" label="React Native" /></span>
    <span title="iOS"><Icon name="apple" label="iOS" /></span>
    <span title="Android"><Icon name="android" label="Android" /></span>
  </section>

  <section class="proof grid" aria-label="How it is checked">
    <div data-reveal style="--i: 0"><span class="display stat">350+</span><p>Tests across logic and components, on every change.</p></div>
    <div data-reveal style="--i: 1"><span class="display stat">iOS 26</span><p>The example app runs on an iOS 26 simulator in CI.</p></div>
    <div data-reveal style="--i: 2"><span class="display stat">Android</span><p>And on an Android emulator, every row driven by Maestro.</p></div>
    <div data-reveal style="--i: 3"><span class="display stat">MIT</span><p>Open source, with a typed API and no runtime dependencies.</p></div>
  </section>

  <section class="band" aria-labelledby="calls">
    <header class="head inset" data-reveal>
      <h2 id="calls" class="display">Every call, on a real device.</h2>
      <p>Pick a call to jump the recording to it. These are screen recordings from CI, not mockups.</p>
    </header>
    <DemoWindow />
  </section>

  <section class="band" aria-labelledby="surfaces">
    <header class="head inset" data-reveal>
      <h2 id="surfaces" class="display">Glass where the platform has it.</h2>
      <p>Liquid Glass on iOS 26. A designed opaque surface everywhere else, and for anyone with Reduce Transparency on.</p>
    </header>
    <ul class="stills grid">
      {
        stills.map((s, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <img src={url(`media/${s.media}.jpg`)} alt={s.alt} loading="lazy" decoding="async" width="600" height="420" />
            <span class="label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band" aria-labelledby="built">
    <header class="head inset" data-reveal>
      <h2 id="built" class="display">Built for a phone, not ported to one.</h2>
    </header>
    <div class="features grid">
      <article class="queue" data-reveal style="--i: 0">
        <h3>A queue, not a pile</h3>
        <p>Three toasts per edge. The rest wait, and each gets its full time once it shows.</p>
        <img src={url('media/android-queue-dark.jpg')} alt="Three toasts showing while two more wait" loading="lazy" decoding="async" width="600" height="420" />
      </article>
      <article data-reveal style="--i: 1">
        <h3>Swipe it away, hold to read</h3>
        <p>Drag with fling velocity to dismiss. Press and hold to pause every timer in the stack.</p>
      </article>
      <article data-reveal style="--i: 2">
        <h3>Twenty calls, one toast</h3>
        <Code code={`toast('Saving draft…', {\n  dedupeKey: 'draft',\n})`} lang="ts" theme="github-dark-dimmed" />
      </article>
      <article data-reveal style="--i: 3">
        <h3>Accessible by default</h3>
        <p>VoiceOver and TalkBack, Reduce Motion, Reduce Transparency, capped font scaling and distinct haptics.</p>
      </article>
      <article data-reveal style="--i: 4">
        <h3>The check draws itself</h3>
        <p>Icons pop in and draw on the motion tokens react-hot-toast is known for, and rest still under Reduce Motion.</p>
      </article>
      <article class="tokens" data-reveal style="--i: 5">
        <h3>Tokens, not overrides</h3>
        <p>Light and dark defaults follow the system, and every token exports as a CSS variable for NativeWind or Unistyles.</p>
        <Code code={`<Toaster theme={{\n  radius: 14,\n  actionColor: '#FF9500',\n}} />`} lang="tsx" theme="github-dark-dimmed" />
      </article>
    </div>
  </section>

  <section class="band migrate" aria-labelledby="migrate">
    <div class="inset">
      <h2 id="migrate" class="display">Already on <span class="nowrap">react-hot-toast</span>?</h2>
      <p>Change the import. The calls you know keep working, and <a href={url('docs/coming-from-react-hot-toast')}>the differences fit on one page</a>.</p>
    </div>
    <div class="diff" data-reveal>
      <CodePanel code={migrate} lang="diff" file="App.tsx" />
    </div>
  </section>

  <section class="band" aria-labelledby="faq">
    <header class="head inset" data-reveal>
      <h2 id="faq" class="display">Questions</h2>
    </header>
    <div class="faq">
      {
        faq.map((f) => (
          <details>
            <summary class="inset">
              {f.q}
              <Icon name="plus" />
            </summary>
            <p class="inset">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="band start dots-wrap" aria-labelledby="start">
    <div class="start-inner inset">
      <h2 id="start" class="display huge" data-reveal>Ship your first toast.</h2>
      <CopyInstall showCommand />
      <div class="setup">
        <CodePanel code={setup} lang="tsx" file="App.tsx" />
      </div>
      <a class="button primary" href={url('docs/installation')}>Quick start <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>

<script>
  // Recordings play only while on screen, and never under Reduce Motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const seen = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting && !reduce.matches && v.offsetParent !== null) void v.play().catch(() => {});
        else v.pause();
      }
    },
    { threshold: 0.35 },
  );
  document.querySelectorAll('video').forEach((v) => seen.observe(v));

  // A clip with data-loop-end restarts there instead of at its end.
  document.querySelectorAll<HTMLVideoElement>('video[data-loop-end]').forEach((v) => {
    const end = Number(v.dataset.loopEnd);
    v.addEventListener('timeupdate', () => {
      if (v.currentTime >= end) v.currentTime = 0;
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: min(calc(100dvh - 64px), 760px);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 72px;
    border-right: 1px solid var(--line);
  }
  .eyebrow {
    margin: 0 0 22px;
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: clamp(44px, 6vw, 80px);
    max-width: 11ch;
  }
  .lede {
    margin: 24px 0 0;
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--muted);
    max-width: 36ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  /* Staged entrance: label, headline, text, buttons, then the phones. */
  @media (prefers-reduced-motion: no-preference) {
    .enter {
      animation: settle 800ms var(--ease-out) both;
      animation-delay: calc(var(--i) * 90ms);
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .hero-devices {
    position: relative;
    display: grid;
    place-items: center;
    padding: 48px var(--pad);
    overflow: hidden;
  }
  .field {
    position: absolute;
    inset: 0;
  }
  /* Warm light under the phones: the 'hot' in hot toast. Tinted, not neon. */
  .glow {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 520px;
    height: 520px;
    transform: translate(-50%, -50%);
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgb(255 173 59 / 0.2), rgb(255 173 59 / 0.07) 38%, transparent 68%);
    pointer-events: none;
  }
  .shot {
    position: relative;
    width: 100%;
    max-width: 560px;
    animation: rise 1000ms 250ms var(--ease-out) both;
  }
  .caption {
    margin: 4px 0 0;
    color: var(--faint);
    text-align: center;
  }
  @keyframes rise {
    from {
      transform: translateY(28px);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot {
      animation: none;
    }
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .platforms span {
    display: grid;
    place-items: center;
    height: 88px;
    color: var(--faint);
    font-size: 26px;
  }
  .platforms span + span {
    border-left: 1px solid var(--line);
  }

  .proof {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .proof > div {
    padding: 28px var(--pad) 30px;
  }
  .stat {
    display: block;
    font-size: clamp(30px, 3vw, 40px);
    color: var(--text);
  }
  .proof p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 30ch;
  }

  .head {
    padding-block: 80px 44px;
  }
  h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 48px);
    max-width: 20ch;
  }
  .head p {
    margin: 14px 0 0;
    color: var(--muted);
    max-width: 58ch;
  }

  /* Bordered cells: the grid's gap shows the line colour behind the cells. */
  .grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border-top: 1px solid var(--line);
  }
  .grid > * {
    background: var(--bg);
  }

  .stills {
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .stills li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    padding: 20px;
    min-width: 0;
  }
  .stills img {
    width: 100%;
    aspect-ratio: 10 / 7;
    object-fit: cover;
    object-position: top;
    background: var(--surface);
  }
  .stills .label {
    color: var(--faint);
  }

  .features {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .features article {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px var(--pad) 36px;
    min-width: 0;
  }
  /* A rule draws across the top of a cell under the pointer. */
  .features article::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 450ms var(--ease-out);
  }
  .features article:hover::before {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .features article::before {
      transition: none;
    }
  }
  .features .queue {
    grid-row: span 2;
    padding-bottom: 0;
  }
  /* Full width under the rest: text on the left, its code on the right. */
  .features .tokens {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: var(--pad);
  }
  .features .tokens :global(.astro-code) {
    grid-column: 2;
    grid-row: 1 / span 2;
    margin-top: 0;
  }
  .features .queue img {
    margin-top: auto;
    width: 100%;
    aspect-ratio: 6 / 5;
    object-fit: cover;
    object-position: top;
    background: var(--surface);
  }
  h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .features p {
    margin: 0;
    color: var(--muted);
  }
  .features :global(.astro-code) {
    margin-top: 8px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    background: var(--surface) !important;
  }

  .migrate {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
  }
  .migrate > .inset {
    padding-block: 72px;
    border-right: 1px solid var(--line);
  }
  .migrate p {
    margin: 14px 0 0;
    color: var(--muted);
    max-width: 44ch;
  }
  .migrate a {
    color: var(--accent);
  }
  .diff {
    padding: 0 var(--pad);
  }


  .faq {
    border-top: 1px solid var(--line);
  }
  details + details {
    border-top: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 22px;
    font-size: 18px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(.icon) {
    color: var(--accent);
    transition: transform 200ms var(--ease-out);
  }
  details[open] summary :global(.icon) {
    transform: rotate(45deg);
  }
  details p {
    margin: 0;
    padding-bottom: 26px;
    color: var(--muted);
    max-width: 70ch;
  }

  .start {
    position: relative;
    overflow: hidden;
  }
  .start::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(243 241 236 / 0.12) 1px, transparent 1.4px);
    background-size: 14px 14px;
    mask-image: radial-gradient(ellipse at 80% 40%, #000 10%, transparent 60%);
    -webkit-mask-image: radial-gradient(ellipse at 80% 40%, #000 10%, transparent 60%);
    pointer-events: none;
  }
  .start-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    justify-items: start;
    padding-block: 88px;
  }
  .setup {
    width: 100%;
    max-width: 600px;
  }
  .huge {
    font-size: clamp(52px, 8.6vw, 124px);
    max-width: 12ch;
    line-height: 0.96;
    margin-bottom: 12px;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .hero-copy {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .stills,
    .proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .features .queue {
      grid-row: auto;
      grid-column: span 2;
    }
    .features .tokens {
      grid-template-columns: minmax(0, 1fr);
    }
    .features .tokens :global(.astro-code) {
      grid-column: 1;
      grid-row: auto;
    }
    .migrate {
      grid-template-columns: minmax(0, 1fr);
    }
    .migrate > .inset {
      border-right: 0;
    }
    .diff {
      padding-bottom: 56px;
    }
  }
  @media (max-width: 640px) {
    .platforms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .platforms span:nth-child(3) {
      border-left: 0;
    }
    .platforms span:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .features {
      grid-template-columns: minmax(0, 1fr);
    }
    .features .queue {
      grid-column: auto;
    }
  }
</style>
