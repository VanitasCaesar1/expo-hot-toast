---
import StarButton from './glass/StarButton';
import { GlassPanel } from './glassyui/glass-panel';
import { url, REPO_URL } from '../lib/url';

interface Props {
  /** Star count at build time. */
  stars?: number;
  /** The Star button; off on the home page, which closes with its own ask. */
  star?: boolean;
}
const { stars, star = true } = Astro.props;

const columns = [
  {
    title: 'Docs',
    links: [
      { label: 'Installation', href: url('docs/installation') },
      { label: 'Quick start', href: url('docs/quick-start') },
      { label: 'Web apps', href: url('docs/web') },
      { label: 'Toaster props', href: url('docs/toaster-props') },
      { label: 'Theming', href: url('docs/theming') },
      { label: 'From react-hot-toast', href: url('docs/coming-from-react-hot-toast') },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: REPO_URL },
      { label: 'Changelog', href: `${REPO_URL}/blob/main/CHANGELOG.md` },
      { label: 'Issues', href: `${REPO_URL}/issues` },
      { label: 'Design notes', href: `${REPO_URL}/blob/main/docs/design.md` },
      { label: 'MIT licence', href: `${REPO_URL}/blob/main/LICENSE` },
    ],
  },
  {
    title: 'Built on',
    links: [
      { label: 'expo-glass-effect', href: 'https://docs.expo.dev/versions/latest/sdk/glass-effect/' },
      { label: 'Reanimated', href: 'https://docs.swmansion.com/react-native-reanimated/' },
      { label: 'Gesture Handler', href: 'https://docs.swmansion.com/react-native-gesture-handler/' },
      { label: 'react-hot-toast', href: 'https://react-hot-toast.com' },
    ],
  },
];
---

<footer class="frame">
  <GlassPanel variant="card" className="footer-card">
    <div class="sign">
      <a class="brand" href={url()}><img class="mark" src={url('mark.svg')} alt="" width="36" height="36" />expo-hot-toast</a>
      <p>Toasts for Expo and React Native. Liquid Glass on iOS 26, Material 3 on Android, frosted glass on the web.</p>
      {star && <StarButton client:visible repo={REPO_URL} initial={stars} label="Star on GitHub" />}
    </div>
    {
      columns.map((c) => (
        <nav class="col" aria-label={c.title}>
          <p class="label">{c.title}</p>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </GlassPanel>

  <p class="wordmark display" aria-hidden="true">expo-<span>hot</span>-toast</p>

  <div class="bottom">
    <p>MIT licensed. The API follows react-hot-toast by Timo Lins; this project is not affiliated with it.</p>
    <a href="#top" class="up">Back to top ↑</a>
  </div>
</footer>

<style>
  footer {
    margin-top: 48px;
    margin-bottom: 32px;
    padding-inline: var(--pad);
    overflow: hidden;
  }
  footer :global(.footer-card) {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    padding: 0;
  }
  .sign {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 20px;
    padding: 40px 36px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .mark {
    display: block;
    width: 36px;
    height: 36px;
    margin-block: -8px;
  }
  .sign p {
    margin: 0;
    max-width: 34ch;
    color: var(--muted);
    line-height: 1.55;
  }
  .col {
    padding: 40px 24px;
  }
  .col .label {
    margin: 0 0 18px;
    color: var(--faint);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  .col a:hover,
  .up:hover {
    color: var(--text);
  }

  /* The sign-off: the name, whole and as wide as the frame. "hot" carries the accent. */
  .wordmark {
    margin: 0;
    padding: clamp(28px, 4vw, 48px) 0 clamp(20px, 3vw, 36px);
    font-size: clamp(44px, 12.6vw, 168px);
    line-height: 1.02;
    letter-spacing: -0.05em;
    white-space: nowrap;
    overflow: hidden;
    background: linear-gradient(var(--wordmark-a), var(--wordmark-b));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
  }
  /* Padded past the glyphs: the tight tracking pushes the last t's bar
     outside the span, where the gradient did not reach. */
  .wordmark span {
    padding-inline: 0.04em 0.12em;
    margin-inline: -0.04em -0.12em;
    background: linear-gradient(#ffc56b, #ff9a12);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    justify-content: space-between;
    align-items: center;
    padding-block: 8px 0;
    color: var(--faint);
    font-size: 13px;
  }
  .bottom p {
    margin: 0;
  }
  .up {
    color: var(--muted);
  }

  @media (max-width: 960px) {
    footer :global(.footer-card) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .sign {
      grid-column: 1 / -1;
      padding-bottom: 8px;
    }
    .col {
      padding: 24px 28px 32px;
    }
  }
  @media (max-width: 560px) {
    footer :global(.footer-card) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
