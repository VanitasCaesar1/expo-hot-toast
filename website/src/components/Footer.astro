---
import { url, REPO_URL } from '../lib/url';
---

<footer class="frame band">
  <div class="inset row">
    <p>MIT licensed open source, for Expo and React Native.</p>
    <nav aria-label="Footer">
      <a href={url('docs')}>Docs</a>
      <a href={REPO_URL}>GitHub</a>
      <a href={`${REPO_URL}/blob/main/CHANGELOG.md`}>Changelog</a>
      <a href={`${REPO_URL}/issues`}>Issues</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-bottom: 1px solid var(--line);
    margin-bottom: 48px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
    padding-block: 28px;
    color: var(--muted);
    font-size: 14px;
  }
  p {
    margin: 0;
  }
  nav {
    display: flex;
    gap: 24px;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--text);
  }
</style>
