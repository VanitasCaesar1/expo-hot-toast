---
import { url, REPO_URL } from '../lib/url';
---

<footer>
  <div class="page row">
    <p>MIT licensed. Built for Expo and React Native.</p>
    <nav aria-label="Footer">
      <a href={url('docs')}>Docs</a>
      <a href={REPO_URL}>GitHub</a>
      <a href={`${REPO_URL}/blob/main/CHANGELOG.md`}>Changelog</a>
      <a href={`${REPO_URL}/issues`}>Issues</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--hairline);
    margin-top: 120px;
    padding: 32px 0 48px;
    color: var(--muted);
    font-size: 14px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    justify-content: space-between;
    align-items: center;
  }
  p {
    margin: 0;
  }
  nav {
    display: flex;
    gap: 24px;
  }
  nav a {
    color: var(--muted);
  }
  nav a:hover {
    color: var(--text);
  }
</style>
