---
/**
 * Know react-hot-toast from the web? The port is one import, shown as the
 * swap itself; then what works the same, what has a native equivalent, and
 * what only this has. The lists follow docs/guide/coming-from-react-hot-toast.md.
 */
import Icon from '../Icon.astro';
import { GlassPanel } from '../glassyui/glass-panel';
import { url } from '../../lib/url';

const same = [
  'toast()', 'toast.success', 'toast.error', 'toast.loading', 'toast.custom', 'toast.promise', 'toast.dismiss', 'toast.remove',
  '<Toaster>', 'position', 'toastOptions', 'reverseOrder', '<ToastBar>', 'iconTheme', 'removeDelay', 'useToaster',
];
const mapped = [
  { web: 'className', native: 'style · textStyle · theme' },
  { web: 'ariaProps', native: 'accessibilityLabel · important' },
  { web: 'up to 20 on screen', native: '3 per edge, the rest queue' },
  { web: 'gutter · toastLimit', native: 'gap · visibleToasts (both still work)' },
];
const only = [
  { icon: 'hand-tap', text: 'Undo actions and a close button' },
  { icon: 'arrows-out-cardinal', text: 'Swipe to dismiss, hold to pause' },
  { icon: 'stack', text: 'A queue, deduplication and a collapsed stack' },
  { icon: 'file-text', text: 'A description line and rich colours' },
  { icon: 'sparkle', text: 'Liquid Glass on iOS 26' },
  { icon: 'eye', text: 'VoiceOver, Reduce Motion, text size, haptics' },
] as const;
---

<div class="migrate-shell inset">
  <div class="migrate-top">
    <div class="migrate-copy">
      <h2 id="migrate" class="display">Know <span class="nowrap">react-hot-toast</span> from the web?</h2>
      <p>
        It renders to the DOM, so it cannot run in an Expo or React Native app. This is its API rebuilt on native views:
        porting a screen is one import.
      </p>
      <a class="text-link" href={url('docs/coming-from-react-hot-toast')}>Every difference, on one page <Icon name="arrow-right" /></a>
    </div>

    <GlassPanel variant="card" className="swap-card">
      <div class="swap-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="swap-file">screens/Checkout.tsx</span>
      </div>
      <pre class="swap-code" aria-label="Change the import from react-hot-toast to expo-hot-toast"><code><span class="k">import</span> toast, {'{'} Toaster {'}'} <span class="k">from</span> <span class="swap"><span class="from">'react-hot-toast'</span><span class="to">'expo-hot-toast'</span></span>;

<span class="c">// Nothing below changes.</span>
<span class="f">toast</span>.<span class="f">promise</span>(saveOrder(cart), {'{'}
  loading: <span class="s">'Placing order…'</span>,
  success: <span class="s">'Order placed'</span>,
  error: <span class="s">'Could not place the order'</span>,
{'}'});</code></pre>
    </GlassPanel>
  </div>

  <div class="compare">
    <GlassPanel variant="card" className="compare-card">
      <p class="compare-title"><Icon name="check" /> Works the same</p>
      <ul class="chips">
        {same.map((s) => <li><code>{s}</code></li>)}
      </ul>
    </GlassPanel>
    <GlassPanel variant="card" className="compare-card">
      <p class="compare-title"><Icon name="swap" /> Has a native equivalent</p>
      <ul class="pairs">
        {
          mapped.map((m) => (
            <li>
              <code class="web">{m.web}</code>
              <Icon name="arrow-right" />
              <span>{m.native}</span>
            </li>
          ))
        }
      </ul>
    </GlassPanel>
    <GlassPanel variant="card" className="compare-card">
      <p class="compare-title"><Icon name="sparkle" /> Only here</p>
      <ul class="only">
        {
          only.map((o) => (
            <li>
              <Icon name={o.icon} />
              {o.text}
            </li>
          ))
        }
      </ul>
    </GlassPanel>
  </div>
</div>

<style>
  .migrate-shell {
    display: grid;
    gap: 16px;
    padding-top: 112px;
  }
  .migrate-top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    margin-bottom: 20px;
  }
  .migrate-copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .migrate-copy h2 {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 48px);
  }
  .migrate-copy p {
    margin: 0;
    color: var(--muted);
    max-width: 44ch;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent-text);
    font-weight: 500;
    text-decoration: none;
  }
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The swap: the old name struck through, the new one written in. */
  .migrate-shell :global(.swap-card) {
    overflow: hidden;
  }
  .swap-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 42px;
    padding: 0 16px;
    border-bottom: 1px solid var(--hairline);
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
    opacity: 0.85;
  }
  .dots i + i {
    background: #febc2e;
  }
  .dots i + i + i {
    background: #28c840;
  }
  .swap-file {
    color: var(--faint);
    font: 12.5px var(--mono);
  }
  .swap-code {
    margin: 0;
    padding: 20px 22px 24px;
    overflow-x: auto;
    color: var(--text);
    font: 14px/1.75 var(--mono);
  }
  .k {
    color: #f47067;
  }
  .f {
    color: #dcbdfb;
  }
  .s {
    color: #96d0ff;
  }
  .c {
    color: var(--faint);
  }
  :root[data-theme='light'] .k {
    color: #cf222e;
  }
  :root[data-theme='light'] .f {
    color: #8250df;
  }
  :root[data-theme='light'] .s {
    color: #0a3069;
  }
  .swap {
    display: inline-grid;
  }
  .swap > span {
    grid-area: 1 / 1;
    border-radius: 4px;
    padding: 0 2px;
  }
  .from {
    color: #f47067;
    background: rgb(244 112 103 / 0.12);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    animation: swap-out 5s ease-in-out infinite;
  }
  .to {
    color: #57ab5a;
    background: rgb(87 171 90 / 0.14);
    animation: swap-in 5s ease-in-out infinite;
  }
  :root[data-theme='light'] .to {
    color: #116329;
  }
  @keyframes swap-out {
    0%, 30% { opacity: 1; text-decoration-color: transparent; }
    40% { opacity: 1; text-decoration-color: currentColor; }
    50%, 92% { opacity: 0; transform: translateY(-6px); }
    100% { opacity: 1; transform: none; text-decoration-color: transparent; }
  }
  @keyframes swap-in {
    0%, 45% { opacity: 0; transform: translateY(6px); }
    55%, 90% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .from {
      display: none;
    }
    .from,
    .to {
      animation: none;
    }
  }

  /* What carries over, what maps, what is new. */
  .compare {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .compare :global(.compare-card) {
    padding: 22px 22px 24px;
    min-width: 0;
  }
  .compare-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
    font-weight: 600;
  }
  .compare-title :global(.icon) {
    color: var(--accent-text);
  }
  .compare ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips code {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid var(--hairline);
    border-radius: 7px;
    background: var(--hover);
    font-size: 12.5px;
  }
  .pairs {
    display: grid;
    gap: 12px;
  }
  .pairs li {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: baseline;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
  }
  .pairs li :global(.icon) {
    color: var(--faint);
    align-self: center;
  }
  .pairs .web {
    color: var(--text);
    font-size: 12.5px;
    text-decoration: line-through;
    text-decoration-color: var(--faint);
  }
  .only {
    display: grid;
    gap: 10px;
  }
  .only li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 14.5px;
  }
  .only li :global(.icon) {
    color: var(--accent-text);
  }

  @media (max-width: 960px) {
    .migrate-top,
    .compare {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
