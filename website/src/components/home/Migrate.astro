---
/**
 * Know react-hot-toast? Porting a screen is one import, shown as the diff
 * itself, beside the few things a native app spells differently. The lists
 * follow docs/guide/coming-from-react-hot-toast.md.
 */
import CodeBlock from '../CodeBlock.astro';
import Icon from '../Icon.astro';
import { url } from '../../lib/url';

const screen = `import toast from 'react-hot-toast';
import toast from 'expo-hot-toast';

export function Checkout({ cart }) {
  const placeOrder = () =>
    toast.promise(saveOrder(cart), {
      loading: 'Placing order…',
      success: 'Order placed',
      error: 'Could not place the order',
    });

  return <Button title="Order" onPress={placeOrder} />;
}`;

/** react-hot-toast on the left, what a native app uses on the right. Code in backticks. */
const changes: Array<[string, string, string?]> = [
  ['`className`', '`style`, `textStyle` and `theme`'],
  ['`ariaProps`', '`accessibilityLabel` and `important`'],
  ['Up to 20 on screen', '3 per position, the rest queue'],
  ['`gutter`, `toastLimit`', '`gap`, `visibleToasts`', 'The old names still work.'],
  ['`useToaster(opts, id)`', '`useToaster({ toastOptions, toasterId })`'],
  ['`calculateOffset`, `updateHeight`', 'Not needed: layout places toasts'],
];

const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (s: string) => escape(s).replace(/`([^`]+)`/g, '<code>$1</code>');
---

<div class="migrate inset">
  <header class="head" data-reveal>
    <h2 id="migrate" class="display">Know <span class="nowrap">react-hot-toast?</span> Change one import.</h2>
    <p>
      react-hot-toast renders to the DOM, so it cannot run in a native app. This is its API rebuilt on native views, so
      the toast code you have ports as it is.
    </p>
  </header>

  <div class="port" data-reveal>
    <div class="port-col">
      <CodeBlock code={screen} lang="tsx" file="screens/Checkout.tsx" removed={[1]} added={[2]} />
      <p class="note">
        <strong>The same:</strong>{' '}<code>toast()</code> and each of its methods, <code>&lt;Toaster&gt;</code> with{' '}
        <code>position</code>, <code>toastOptions</code> and <code>reverseOrder</code>, <code>&lt;ToastBar&gt;</code>,{' '}
        <code>iconTheme</code>, <code>removeDelay</code> and <code>resolveValue</code>.
      </p>
    </div>

    <div class="port-col">
      <div class="changes">
        <table>
          <caption class="visually-hidden">What a native app spells differently</caption>
          <thead>
            <tr>
              <th scope="col"><Icon name="react" /> react-hot-toast</th>
              <th scope="col"><img src={url('mark.svg')} alt="" width="16" height="16" /> expo-hot-toast</th>
            </tr>
          </thead>
          <tbody>
            {
              changes.map(([web, native, aside]) => (
                <tr>
                  <td class="web" set:html={inline(web)} />
                  <td class="native">
                    <Fragment set:html={inline(native)} />
                    {aside && <span class="aside">{aside}</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note">
        <strong>Only here:</strong>{' '}<a href={url('docs/actions')}>Undo and other actions</a>,{' '}
        <a href={url('docs/rich-toasts')}>rich toasts</a>, swipe to dismiss, <code>toast.update</code>,{' '}
        <code>dedupeKey</code>, a queue, and Liquid Glass on iOS 26.
      </p>
    </div>
  </div>

  <a class="text-link more" href={url('docs/coming-from-react-hot-toast')}>Every difference, on one page <Icon name="arrow-right" /></a>
</div>

<style>
  .migrate {
    padding-bottom: 8px;
  }

  /* The diff beside the table, each with its note under it. */
  .port {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .port-col {
    display: grid;
    gap: 16px;
    min-width: 0;
  }
  .note {
    margin: 0;
    padding: 0 4px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .note strong {
    color: var(--text);
    font-weight: 600;
  }
  .note code,
  .changes code {
    font-size: 0.9em;
  }
  .note code {
    color: var(--text);
  }
  .note a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .note a:hover {
    text-decoration-color: currentColor;
  }

  /* The table wears the code block's surface, so the pair reads as one. */
  .changes {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    box-shadow:
      0 1px 2px var(--hairline),
      0 12px 28px -18px var(--shadow);
  }
  .changes table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .changes th {
    height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(var(--surface-raised), color-mix(in srgb, var(--surface-raised) 60%, var(--surface)));
    color: var(--muted);
    font: 500 13px var(--mono);
    text-align: left;
    white-space: nowrap;
  }
  .changes th :global(.icon),
  .changes th img {
    display: inline-block;
    width: 15px;
    height: 15px;
    margin-right: 6px;
    vertical-align: -3px;
  }
  .changes th :global(.icon) {
    color: #58c4dc;
  }
  .changes th + th {
    color: var(--text);
  }
  .changes th:first-child,
  .changes td.web {
    width: 42%;
  }
  .changes td {
    padding: 13px 16px;
    vertical-align: top;
    font-size: 14px;
    line-height: 1.55;
  }
  .changes tr + tr td {
    border-top: 1px solid var(--hairline);
  }
  .changes td.web {
    color: var(--muted);
  }
  .changes td.web :global(code) {
    color: var(--muted);
  }
  .changes td.native {
    color: var(--text);
  }
  .aside {
    display: block;
    margin-top: 2px;
    color: var(--faint);
    font-size: 13px;
  }
  .changes :global(code) {
    overflow-wrap: anywhere;
  }

  .more {
    margin-top: 28px;
  }

  @media (max-width: 960px) {
    .port {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* A phone stacks each row: the old name over the new one. */
  @media (max-width: 560px) {
    .changes thead {
      display: none;
    }
    .changes tr {
      display: grid;
      gap: 2px;
      padding: 12px 16px;
    }
    .changes tr + tr {
      border-top: 1px solid var(--hairline);
    }
    .changes td,
    .changes tr + tr td {
      width: auto !important;
      padding: 0;
      border: 0;
    }
    .changes td.web {
      font-size: 13px;
    }
    .changes td.web::after {
      content: '  \2192';
      color: var(--faint);
    }
  }
</style>
