---
/**
 * The example app, built for the web by Expo, in a phone. It is the library
 * itself running on react-native-web, so everything in it is real: the queue,
 * the gestures, the timers. The web draws the opaque surface, not glass.
 */
import { url } from '../lib/url';

const tries = [
  { what: 'Tap Promise', api: 'toast.promise()' },
  { what: 'Flick a toast up to dismiss it', api: 'swipe toward the edge' },
  { what: 'Tap Burst of five, then Stacked', api: 'visibleToasts · stacked' },
  { what: 'Press and hold a toast', api: 'pauses every timer' },
];
---

<div class="playground">
  <figure class="device">
    <div class="frame">
      <div class="screen" data-screen>
        <iframe
          src={url('playground/')}
          title="The expo-hot-toast example app, running in your browser"
          loading="lazy"
          data-app
        ></iframe>
        <p class="loading label" data-loading>Loading the app…</p>
      </div>
    </div>
  </figure>

  <div class="side">
    <p class="label kicker">Try it</p>
    <ol>
      {
        tries.map((t, i) => (
          <li>
            <span class="n label">{String(i + 1).padStart(2, '0')}</span>
            <span class="what">{t.what}</span>
            <code>{t.api}</code>
          </li>
        ))
      }
    </ol>
    <p class="note">
      This is the example app and the library, built for the web with Expo and running on React Native Web. The web
      draws the opaque surface; Liquid Glass needs iOS 26, as in the recordings above.
    </p>
  </div>
</div>

<script>
  // The app is laid out at a real phone's 402 x 874 points and scaled to fit
  // the frame, so it renders exactly as it would on the device.
  const PHONE_WIDTH = 402;
  for (const screen of document.querySelectorAll<HTMLElement>('[data-screen]')) {
    const frame = screen.querySelector<HTMLIFrameElement>('[data-app]');
    const loading = screen.querySelector<HTMLElement>('[data-loading]');
    if (!frame) continue;
    // Width sets the scale; the height fills whatever the frame leaves, so the
    // app reaches the bottom edge whatever the frame's border takes.
    const fit = () => {
      const scale = screen.clientWidth / PHONE_WIDTH;
      screen.style.setProperty('--scale', String(scale));
      screen.style.setProperty('--app-height', `${screen.clientHeight / scale}px`);
    };
    new ResizeObserver(fit).observe(screen);
    fit();
    frame.addEventListener('load', () => loading?.remove(), { once: true });
  }
</script>

<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding: clamp(36px, 5vw, 64px) var(--pad);
  }
  .device {
    margin: 0;
    container-type: inline-size;
  }
  /* iPhone 17 Pro proportions, as in Phone.astro: aluminium edge, black border. */
  .frame {
    padding: 0.9cqw;
    border-radius: 16.4cqw;
    background: linear-gradient(150deg, #6b6e73, #2b2d31 22%, #1c1d20 55%, #3c3f44 80%, #6b6e73);
    box-shadow:
      inset 0 0 0 0.25cqw rgb(255 255 255 / 0.14),
      0 50px 100px -40px rgb(255 173 59 / 0.25),
      0 40px 80px -30px rgb(0 0 0 / 0.85);
  }
  .screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 402 / 874;
    border: 2.4cqw solid #000;
    border-radius: 15.5cqw;
    background: #000;
  }
  iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 402px;
    height: var(--app-height, 874px);
    border: 0;
    transform: scale(var(--scale, 0.85));
    transform-origin: 0 0;
    background: #f2f2f7;
  }
  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: var(--faint);
    background: #000;
  }

  .side {
    display: grid;
    gap: 24px;
    align-content: center;
  }
  .kicker {
    margin: 0;
    color: var(--accent);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .n {
    color: var(--faint);
  }
  .what {
    font-size: clamp(17px, 1.5vw, 20px);
    color: var(--text);
  }
  li code {
    color: var(--accent);
    font-size: 13px;
    white-space: nowrap;
  }
  .note {
    margin: 0;
    max-width: 52ch;
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .playground {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .device {
      width: min(100%, 340px);
    }
    li {
      grid-template-columns: 32px minmax(0, 1fr);
    }
    li code {
      grid-column: 2;
    }
  }
</style>
