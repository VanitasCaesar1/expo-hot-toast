---
import { Code } from 'astro:components';
import Phone from './Phone.astro';
import { moments } from '../lib/moments';
---

<div class="playground" data-platform="ios">
  <div class="device">
    <div class="switch" role="group" aria-label="Platform">
      <button type="button" data-show="ios" aria-pressed="true">iOS 26</button>
      <button type="button" data-show="android" aria-pressed="false">Android</button>
    </div>
    <div class="stage">
      <div class="ios-only"><Phone platform="ios" media="ios-demo" label="The demo on iOS 26 with Liquid Glass" id="play-ios" /></div>
      <div class="android-only"><Phone platform="android" media="android-demo" label="The demo on Android" id="play-android" /></div>
    </div>
  </div>

  <ol class="moments">
    {
      moments.map((m) => (
        <li>
          <button
            type="button"
            data-moment={m.id}
            data-at-ios={m.at.ios}
            data-at-android={m.at.android}
          >
            <Code code={m.code} lang="ts" themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
            <span class="note">{m.note}</span>
          </button>
        </li>
      ))
    }
  </ol>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.playground');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-moment]')];
    const video = () =>
      root.querySelector<HTMLVideoElement>(root.dataset.platform === 'ios' ? '#play-ios' : '#play-android');
    const at = (b: HTMLButtonElement) => Number(b.dataset[root.dataset.platform === 'ios' ? 'atIos' : 'atAndroid']);

    // Jump the recording to the moment the call fires.
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const v = video();
        if (!v) return;
        v.currentTime = Math.max(0, at(button) - 0.3);
        void v.play().catch(() => {});
      });
    }

    // Follow the recording: the moment playing now is the one marked current.
    const sync = () => {
      const v = video();
      if (!v) return;
      let current: HTMLButtonElement | undefined;
      for (const b of buttons) if (v.currentTime + 0.05 >= at(b) - 0.3) current = b;
      for (const b of buttons) b.toggleAttribute('data-current', b === current);
    };
    root.querySelectorAll('video').forEach((v) => v.addEventListener('timeupdate', sync));

    for (const toggle of root.querySelectorAll<HTMLButtonElement>('[data-show]')) {
      toggle.addEventListener('click', () => {
        const from = video();
        root.dataset.platform = toggle.dataset.show;
        root.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((t) =>
          t.setAttribute('aria-pressed', String(t === toggle)),
        );
        from?.pause();
        const to = video();
        if (to && !matchMedia('(prefers-reduced-motion: reduce)').matches) void to.play().catch(() => {});
      });
    }
  }
</script>

<style>
  .playground {
    display: grid;
    grid-template-columns: minmax(240px, 300px) 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }
  .device {
    position: sticky;
    top: 92px;
    display: grid;
    gap: 18px;
    justify-items: center;
  }
  .stage {
    width: 100%;
  }
  .playground[data-platform='ios'] .android-only,
  .playground[data-platform='android'] .ios-only {
    display: none;
  }
  .switch {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--pill);
    background: var(--surface-sunk);
  }
  .switch button {
    border: 0;
    padding: 7px 16px;
    border-radius: var(--pill);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 14px;
    font-weight: 540;
    cursor: pointer;
  }
  .switch button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .moments {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .moments button {
    width: 100%;
    display: grid;
    gap: 2px;
    padding: 4px 4px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 200ms, transform 200ms var(--ease-out), box-shadow 200ms;
  }
  .moments button:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--hairline));
  }
  .moments button:active {
    transform: scale(0.99);
  }
  .moments button[data-current] {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .moments :global(.astro-code) {
    padding: 14px 18px 6px;
    font-size: 14px;
  }
  .note {
    padding: 0 18px;
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 767px) {
    .playground {
      grid-template-columns: 1fr;
    }
    .device {
      position: static;
      max-width: 260px;
      margin-inline: auto;
    }
  }
</style>
