---
/**
 * A real recording in a plain device bezel. The video source follows the
 * colour scheme (see the script in pages/index.astro), so dark-mode visitors
 * see the dark-mode recording.
 */
import { url } from '../lib/url';

interface Props {
  platform: 'ios' | 'android';
  /** Base name of the media files: `<name>-light.mp4`, `<name>-dark.jpg`, ... */
  media: string;
  label: string;
  id?: string;
}

const { platform, media, label, id } = Astro.props;
const file = (scheme: 'light' | 'dark', ext: string) => url(`media/${media}-${scheme}.${ext}`);
---

<figure class:list={['phone', platform]}>
  <div class="frame">
  <div class="screen">
    <video
      id={id}
      data-light={file('light', 'mp4')}
      data-dark={file('dark', 'mp4')}
      data-poster-light={file('light', 'jpg')}
      data-poster-dark={file('dark', 'jpg')}
      poster={file('light', 'jpg')}
      muted
      loop
      playsinline
      preload="none"
      aria-label={label}
    ></video>
  </div>
  </div>
  <figcaption class="visually-hidden">{label}</figcaption>
</figure>

<style>
  /* The figure is the size container; the frame inside sizes its bezel and
     corners from it, so they scale with the phone, not the viewport. */
  .phone {
    margin: 0;
    container-type: inline-size;
  }
  .frame {
    padding: 3.4cqw;
    background: #1c1c1e;
    border-radius: 17cqw;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 2px 4px rgb(0 0 0 / 0.12),
      0 30px 60px -20px rgb(0 0 0 / 0.35);
  }
  .android .frame {
    border-radius: 11cqw;
  }
  .screen {
    overflow: hidden;
    border-radius: 13.8cqw;
    background: var(--surface-sunk);
    aspect-ratio: 1206 / 2622;
  }
  .android .screen {
    border-radius: 8cqw;
    aspect-ratio: 1080 / 2400;
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
