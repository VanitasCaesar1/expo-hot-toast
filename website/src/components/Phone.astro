---
/**
 * A real recording in a plain device bezel. The site is dark, so the dark-mode
 * recording plays by default; the demo window can switch it to light.
 */
import { url } from '../lib/url';

interface Props {
  platform: 'ios' | 'android';
  /** Base name of the media files: `<name>-dark.mp4`, `<name>-light.jpg`, ... */
  media: string;
  label: string;
  id?: string;
}

const { platform, media, label, id } = Astro.props;
const file = (scheme: 'light' | 'dark', ext: string) => url(`media/${media}-${scheme}.${ext}`);
---

<figure class:list={['phone', platform]}>
  <div class="frame-bezel">
    <div class="glass-border">
    <div class="screen">
      <video
        id={id}
        src={file('dark', 'mp4')}
        poster={file('dark', 'jpg')}
        data-light={file('light', 'mp4')}
        data-dark={file('dark', 'mp4')}
        data-poster-light={file('light', 'jpg')}
        data-poster-dark={file('dark', 'jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label={label}
      ></video>
    </div>
    </div>
  </div>
</figure>

<style>
  /*
   * Drawn in CSS to iPhone 17 Pro proportions rather than from Apple's bezel
   * images: a thin aluminium edge, a uniform black border, the display's own
   * corner radius (55pt on a 402pt screen) and the side buttons. The figure is
   * the size container, so everything scales with it.
   */
  .phone {
    margin: 0;
    container-type: inline-size;
    padding-inline: 1cqw;
  }
  .frame-bezel {
    position: relative;
    padding: 0.9cqw;
    border-radius: 16.4cqw;
    background: linear-gradient(150deg, #6b6e73, #2b2d31 22%, #1c1d20 55%, #3c3f44 80%, #6b6e73);
    box-shadow:
      inset 0 0 0 0.25cqw rgb(255 255 255 / 0.14),
      0 40px 80px -30px rgb(0 0 0 / 0.85);
  }
  /* Side buttons: power and Camera Control on the right, Action and volume on the left. */
  .frame-bezel::before,
  .frame-bezel::after {
    content: '';
    position: absolute;
    width: 0.9cqw;
    background: #3a3c40;
  }
  .frame-bezel::before {
    right: -0.75cqw;
    top: 27%;
    height: 11%;
    border-radius: 0 0.6cqw 0.6cqw 0;
    box-shadow: 0 calc(100cqw * 0.42) 0 -0.1cqw #3a3c40;
  }
  .frame-bezel::after {
    left: -0.75cqw;
    top: 17%;
    height: 4.5%;
    border-radius: 0.6cqw 0 0 0.6cqw;
    box-shadow:
      0 calc(100cqw * 0.17) 0 0 #3a3c40,
      0 calc(100cqw * 0.32) 0 0 #3a3c40;
  }
  .glass-border {
    padding: 2.4cqw;
    border-radius: 15.5cqw;
    background: #000;
  }
  .screen {
    overflow: hidden;
    border-radius: 12.8cqw;
    background: #000;
    aspect-ratio: 1206 / 2622;
  }
  /* Pixel proportions: flatter corners, one button rail on the right. */
  .android .frame-bezel {
    border-radius: 10.5cqw;
    background: linear-gradient(150deg, #4a4c50, #232427 30%, #1a1b1d 60%, #3a3c40);
  }
  .android .frame-bezel::after {
    display: none;
  }
  .android .frame-bezel::before {
    top: 22%;
    height: 8%;
    box-shadow: 0 calc(100cqw * 0.26) 0 0 #3a3c40;
  }
  .android .glass-border {
    border-radius: 9.6cqw;
    padding: 2.6cqw;
  }
  .android .screen {
    border-radius: 7.4cqw;
    aspect-ratio: 1080 / 2400;
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
