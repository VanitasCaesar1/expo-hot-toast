---
/**
 * A real recording in a plain device bezel. The site is dark, so the dark-mode
 * recording plays by default; the demo window can switch it to light.
 */
import { url } from '../lib/url';

interface Props {
  platform: 'ios' | 'android';
  /** Base name of the media files: `<name>-dark.mp4`, `<name>-light.jpg`, ... */
  media: string;
  label: string;
  id?: string;
}

const { platform, media, label, id } = Astro.props;
const file = (scheme: 'light' | 'dark', ext: string) => url(`media/${media}-${scheme}.${ext}`);
---

<figure class:list={['phone', platform]}>
  <div class="frame-bezel">
    <div class="screen">
      <video
        id={id}
        src={file('dark', 'mp4')}
        poster={file('dark', 'jpg')}
        data-light={file('light', 'mp4')}
        data-dark={file('dark', 'mp4')}
        data-poster-light={file('light', 'jpg')}
        data-poster-dark={file('dark', 'jpg')}
        muted
        loop
        playsinline
        preload="none"
        aria-label={label}
      ></video>
    </div>
  </div>
</figure>

<style>
  /* The figure is the size container; the bezel and corners scale with it. */
  .phone {
    margin: 0;
    container-type: inline-size;
  }
  .frame-bezel {
    padding: 3.2cqw;
    background: #0b0b0a;
    border-radius: 17cqw;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 80px -30px rgb(0 0 0 / 0.8);
  }
  .android .frame-bezel {
    border-radius: 11cqw;
  }
  .screen {
    overflow: hidden;
    border-radius: 14cqw;
    background: #000;
    aspect-ratio: 1206 / 2622;
  }
  .android .screen {
    border-radius: 8cqw;
    aspect-ratio: 1080 / 2400;
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
