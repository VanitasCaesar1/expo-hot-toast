---
import { Code } from 'astro:components';
import { GlassPanel } from './glassyui/glass-panel';
import CopyButton from './glass/CopyButton';

interface Props {
  code: string;
  lang: 'ts' | 'tsx' | 'diff' | 'sh';
  /** Shown in the panel header, e.g. `App.tsx`. */
  file?: string;
}

const { code, lang, file } = Astro.props;
const copyable = lang === 'diff' ? code.split('\n').filter((l) => l.startsWith('+')).map((l) => l.slice(2)).join('\n') : code;
---

<GlassPanel variant="card" className="code-panel">
  <div class="bar">
    <span class="label">{file ?? lang}</span>
    <CopyButton text={copyable} label={`Copy ${file ?? 'code'}`} iconOnly variant="ghost" size="sm" />
  </div>
  <Code code={code} lang={lang} themes={{ light: 'github-light', dark: 'github-dark-dimmed' }} defaultColor={false} />
</GlassPanel>

<style>
  :global(.code-panel) {
    min-width: 0;
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    padding: 0 8px 0 18px;
    border-bottom: 1px solid var(--hairline);
    color: var(--faint);
  }
</style>
