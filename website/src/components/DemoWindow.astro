---
import { url } from '../lib/url';
import CodePanel from './CodePanel.astro';
import { moments } from '../lib/moments';
---

<div class="demo" data-scheme="dark" data-pan="top">
  <div class="tabs" role="tablist" aria-label="API calls">
    {
      moments.map((m, i) => (
        <button
          type="button"
          role="tab"
          class="tab label"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="demo-panel"
          data-at-ios={m.at.ios}
          data-at-android={m.at.android}
          data-pan={m.id === 'position' ? 'bottom' : 'top'}
        >
          {m.tab}
        </button>
      ))
    }
  </div>

  <div class="stage" id="demo-panel" role="tabpanel">
    {
      [
        { platform: 'ios', id: 'demo-ios', media: 'ios-demo', caption: 'iOS 26 · Liquid Glass', label: 'The demo running on iOS 26 with Liquid Glass' },
        { platform: 'android', id: 'demo-android', media: 'android-demo', caption: 'Android · opaque surface', label: 'The same demo running on Android' },
      ].map((d) => (
        <figure class:list={['win', d.platform]}>
          <div class="lens">
            <video
              id={d.id}
              src={url(`media/${d.media}-dark.mp4`)}
              poster={url(`media/${d.media}-dark.jpg`)}
              data-dark={url(`media/${d.media}-dark.mp4`)}
              data-light={url(`media/${d.media}-light.mp4`)}
              data-poster-dark={url(`media/${d.media}-dark.jpg`)}
              data-poster-light={url(`media/${d.media}-light.jpg`)}
              muted
              loop
              playsinline
              preload="none"
              aria-label={d.label}
            />
          </div>
          <figcaption class="label">{d.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="detail">
    <div class="calls">
      {
        moments.map((m, i) => (
          <div class="call" data-call={i} hidden={i !== 0}>
            <CodePanel code={m.code} lang="ts" file="App.tsx" />
          </div>
        ))
      }
    </div>
    <div class="aside">
      {
        moments.map((m, i) => (
          <p class="note" data-note={i} hidden={i !== 0}>
            {m.note}
          </p>
        ))
      }
      <div class="seg" role="group" aria-label="Appearance">
        <button type="button" class="label" data-scheme-to="dark" aria-pressed="true">Dark</button>
        <button type="button" class="label" data-scheme-to="light" aria-pressed="false">Light</button>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.demo');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const calls = [...root.querySelectorAll<HTMLElement>('[data-call]')];
    const notes = [...root.querySelectorAll<HTMLElement>('[data-note]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const ios = root.querySelector<HTMLVideoElement>('#demo-ios');
    const android = root.querySelector<HTMLVideoElement>('#demo-android');
    const atIos = (t: HTMLButtonElement) => Number(t.dataset.atIos);
    const atAndroid = (t: HTMLButtonElement) => Number(t.dataset.atAndroid);

    const select = (index: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === index)));
      calls.forEach((c, i) => (c.hidden = i !== index));
      notes.forEach((n, i) => (n.hidden = i !== index));
      // Both lenses pan to where the selected call's toast lands.
      root.dataset.pan = tabs[index]!.dataset.pan ?? 'top';
    };

    // A tab jumps both recordings to the moment its call fires.
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        select(i);
        for (const [v, at] of [
          [ios, atIos(tab)],
          [android, atAndroid(tab)],
        ] as const) {
          if (!v) continue;
          v.currentTime = Math.max(0, at - 0.3);
          if (!reduce.matches) void v.play().catch(() => {});
        }
      }),
    );

    // The iOS clip leads: the tab follows it, and the tab's bar fills through
    // that call's stretch of the clip.
    ios?.addEventListener('timeupdate', () => {
      if (ios.paused) return;
      let current = 0;
      tabs.forEach((t, i) => {
        if (ios.currentTime >= atIos(t) - 0.3) current = i;
      });
      if (tabs[current]!.getAttribute('aria-selected') !== 'true') select(current);
      const start = atIos(tabs[current]!) - 0.3;
      const end = current + 1 < tabs.length ? atIos(tabs[current + 1]!) - 0.3 : ios.duration || start + 4;
      const progress = Math.min(Math.max((ios.currentTime - start) / (end - start), 0), 1);
      tabs.forEach((t, i) => t.style.setProperty('--progress', i === current ? String(progress) : '0'));
    });

    const swap = (v: HTMLVideoElement | null, scheme: 'dark' | 'light') => {
      if (!v) return;
      const t = v.currentTime;
      const playing = !v.paused;
      v.poster = v.dataset[scheme === 'dark' ? 'posterDark' : 'posterLight'] ?? '';
      v.src = v.dataset[scheme] ?? '';
      v.addEventListener('loadedmetadata', () => (v.currentTime = t), { once: true });
      if (playing) void v.play().catch(() => {});
    };

    root.querySelectorAll<HTMLButtonElement>('[data-scheme-to]').forEach((b) =>
      b.addEventListener('click', () => {
        const scheme = b.dataset.schemeTo === 'light' ? 'light' : 'dark';
        root.dataset.scheme = scheme;
        root.querySelectorAll('[data-scheme-to]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        swap(ios, scheme);
        swap(android, scheme);
      }),
    );
  }
</script>

<style>
  .tabs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .tab {
    position: relative;
    height: 54px;
    padding: 0 10px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition:
      color 160ms,
      background 160ms;
  }
  .tab:last-child {
    border-right: 0;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab[aria-selected='true'] {
    color: var(--text);
    background: var(--surface);
  }
  /* The selected tab's rule: a faint track, filled as far as the clip has played. */
  .tab[aria-selected='true']::before,
  .tab::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
  }
  .tab[aria-selected='true']::before {
    background: rgb(255 173 59 / 0.25);
  }
  .tab::after {
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    transition: transform 250ms linear;
  }
  .tab[aria-selected='true']:not([style*='--progress'])::after {
    transform: scaleX(1);
  }

  /*
   * Two lenses on the recordings, at about 1.4x a real phone, so the toasts are
   * readable. Each shows the part of the screen where toasts land: the top,
   * or the bottom for the bottom-positioned call.
   */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(32px, 4vw, 56px) var(--pad) 0;
    isolation: isolate;
  }
  .stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(243 241 236 / 0.12) 1px, transparent 1.4px);
    background-size: 14px 14px;
    mask-image: radial-gradient(ellipse at 50% 40%, #000 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 40%, #000 10%, transparent 70%);
  }
  .win {
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .lens {
    overflow: hidden;
    aspect-ratio: 6 / 5;
    border-radius: 22px;
    background: #000;
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .demo[data-scheme='light'] .lens {
    background: #f2f2f7;
  }
  .lens video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: object-position 700ms var(--ease-out);
  }
  .demo[data-pan='bottom'] .lens video {
    object-position: 50% 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .lens video {
      transition: none;
    }
  }
  .win figcaption {
    color: var(--faint);
  }

  .detail {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
    padding: 28px var(--pad) clamp(32px, 4vw, 56px);
  }
  /* Tall enough for the longest call, so switching tabs does not move the page. */
  .calls {
    min-height: 196px;
  }
  .aside {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .note {
    margin: 0;
    color: var(--text);
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.45;
    max-width: 30ch;
  }
  .seg {
    display: inline-flex;
    border: 1px solid var(--line);
  }
  .seg button {
    height: 34px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
  }
  .seg button + button {
    border-left: 1px solid var(--line);
  }
  .seg button[aria-pressed='true'] {
    color: var(--accent-ink);
    background: var(--accent);
  }

  @media (max-width: 760px) {
    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tab:nth-child(3) {
      border-right: 0;
    }
    .tab:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
    .stage,
    .detail {
      grid-template-columns: minmax(0, 1fr);
    }
    .calls {
      min-height: 0;
    }
  }
</style>
