---
import Phone from './Phone.astro';
import CodePanel from './CodePanel.astro';
import { moments } from '../lib/moments';
---

<div class="demo" data-scheme="dark">
  <div class="tabs" role="tablist" aria-label="API calls">
    {
      moments.map((m, i) => (
        <button
          type="button"
          role="tab"
          class="tab label"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="demo-panel"
          data-at-ios={m.at.ios}
          data-at-android={m.at.android}
        >
          {m.tab}
        </button>
      ))
    }
  </div>

  <div class="window" id="demo-panel" role="tabpanel">
    <figure class="device">
      <Phone platform="ios" media="ios-demo" label="The demo running on iOS 26 with Liquid Glass" id="demo-ios" />
      <figcaption class="label">iOS 26, Liquid Glass</figcaption>
    </figure>
    <figure class="device">
      <Phone platform="android" media="android-demo" label="The same demo running on Android" id="demo-android" />
      <figcaption class="label">Android</figcaption>
    </figure>

    <div class="side">
      <div class="seg" role="group" aria-label="Appearance">
        <button type="button" class="label" data-scheme-to="dark" aria-pressed="true">Dark</button>
        <button type="button" class="label" data-scheme-to="light" aria-pressed="false">Light</button>
      </div>
      {
        moments.map((m, i) => (
          <div class="call" data-call={i} hidden={i !== 0}>
            <CodePanel code={m.code} lang="ts" file="App.tsx" />
            <p>{m.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.demo');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const calls = [...root.querySelectorAll<HTMLElement>('[data-call]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const ios = root.querySelector<HTMLVideoElement>('#demo-ios');
    const android = root.querySelector<HTMLVideoElement>('#demo-android');
    const atIos = (t: HTMLButtonElement) => Number(t.dataset.atIos);
    const atAndroid = (t: HTMLButtonElement) => Number(t.dataset.atAndroid);

    const select = (index: number) => {
      tabs.forEach((t, i) => t.setAttribute('aria-selected', String(i === index)));
      calls.forEach((c, i) => (c.hidden = i !== index));
    };

    // A tab jumps both recordings to the moment its call fires.
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        select(i);
        for (const [v, at] of [
          [ios, atIos(tab)],
          [android, atAndroid(tab)],
        ] as const) {
          if (!v) continue;
          v.currentTime = Math.max(0, at - 0.3);
          if (!reduce.matches) void v.play().catch(() => {});
        }
      }),
    );

    // The iOS clip leads: the tab follows it, and the tab's bar fills through
    // that call's stretch of the clip.
    ios?.addEventListener('timeupdate', () => {
      if (ios.paused) return;
      let current = 0;
      tabs.forEach((t, i) => {
        if (ios.currentTime >= atIos(t) - 0.3) current = i;
      });
      if (tabs[current]!.getAttribute('aria-selected') !== 'true') select(current);
      const start = atIos(tabs[current]!) - 0.3;
      const end = current + 1 < tabs.length ? atIos(tabs[current + 1]!) - 0.3 : ios.duration || start + 4;
      const progress = Math.min(Math.max((ios.currentTime - start) / (end - start), 0), 1);
      tabs.forEach((t, i) => t.style.setProperty('--progress', i === current ? String(progress) : '0'));
    });

    const swap = (v: HTMLVideoElement | null, scheme: 'dark' | 'light') => {
      if (!v) return;
      const t = v.currentTime;
      const playing = !v.paused;
      v.poster = v.dataset[scheme === 'dark' ? 'posterDark' : 'posterLight'] ?? '';
      v.src = v.dataset[scheme] ?? '';
      v.addEventListener('loadedmetadata', () => (v.currentTime = t), { once: true });
      if (playing) void v.play().catch(() => {});
    };

    root.querySelectorAll<HTMLButtonElement>('[data-scheme-to]').forEach((b) =>
      b.addEventListener('click', () => {
        const scheme = b.dataset.schemeTo === 'light' ? 'light' : 'dark';
        root.dataset.scheme = scheme;
        root.querySelectorAll('[data-scheme-to]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        swap(ios, scheme);
        swap(android, scheme);
      }),
    );
  }
</script>

<style>
  .tabs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .tab {
    position: relative;
    height: 54px;
    padding: 0 10px;
    border: 0;
    border-right: 1px solid var(--line);
    background: transparent;
    color: var(--faint);
    cursor: pointer;
    transition:
      color 160ms,
      background 160ms;
  }
  .tab:last-child {
    border-right: 0;
  }
  .tab:hover {
    color: var(--text);
  }
  .tab[aria-selected='true'] {
    color: var(--text);
    background: var(--surface);
  }
  /* The selected tab's rule: a faint track, filled as far as the clip has played. */
  .tab[aria-selected='true']::before,
  .tab::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
  }
  .tab[aria-selected='true']::before {
    background: rgb(255 173 59 / 0.25);
  }
  .tab::after {
    background: var(--accent);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    transition: transform 250ms linear;
  }
  .tab[aria-selected='true']:not([style*='--progress'])::after {
    transform: scaleX(1);
  }

  .window {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 250px) minmax(0, 236px) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
    padding: clamp(36px, 5vw, 64px) var(--pad);
    isolation: isolate;
  }
  .window::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(243 241 236 / 0.13) 1px, transparent 1.4px);
    background-size: 14px 14px;
    mask-image: radial-gradient(ellipse at 28% 50%, #000 15%, transparent 65%);
    -webkit-mask-image: radial-gradient(ellipse at 28% 50%, #000 15%, transparent 65%);
  }
  .device {
    margin: 0;
    display: grid;
    gap: 14px;
    justify-items: center;
  }
  /* A size container has no width of its own; give the phone the column's. */
  .device :global(.phone) {
    width: 100%;
  }
  .device figcaption {
    color: var(--faint);
  }

  .side {
    display: grid;
    gap: 20px;
    align-content: center;
    padding-left: clamp(0px, 2vw, 24px);
  }
  .seg {
    display: inline-flex;
    justify-self: start;
    border: 1px solid var(--line);
  }
  .seg button {
    height: 34px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
  }
  .seg button + button {
    border-left: 1px solid var(--line);
  }
  .seg button[aria-pressed='true'] {
    color: var(--accent-ink);
    background: var(--accent);
  }
  .call p {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.5;
    max-width: 36ch;
  }

  @media (max-width: 1000px) {
    .window {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .side {
      grid-column: 1 / -1;
      padding-left: 0;
    }
  }
  @media (max-width: 760px) {
    .tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .tab:nth-child(3) {
      border-right: 0;
    }
    .tab:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
