---
/**
 * Clerk's page actions: copy the page as Markdown, or open it in an AI chat,
 * each with its own logo, plus the plain-text versions. No JavaScript beyond
 * closing the menu: links, and the site's delegated [data-copy] handler.
 */
import Icon from '../Icon.astro';
import { url } from '../../lib/url';
import { SITE } from '../../lib/ai';
import { AI_CHATS, logoSvg } from '../../lib/ai-brands';

interface Props {
  slug: string;
  title: string;
  markdown: string;
}

const { slug, title, markdown } = Astro.props;
const mdUrl = `${SITE}/docs/md/${slug}.md`;
const prompt = `Read ${mdUrl}, the expo-hot-toast docs page "${title}", so I can ask you questions about it.`;
const [first, ...rest] = AI_CHATS;
---

<div class="page-actions">
  <button type="button" class="pa-button" data-copy={markdown}>
    <span class="copy-idle"><Icon name="markdown-logo" /> Copy as markdown</span>
    <span class="copy-done"><Icon name="check" /> Copied</span>
  </button>
  <div class="split">
    <a class="pa-button" href={first!.url(prompt)} target="_blank" rel="noopener">
      <span class="ai-logo" set:html={logoSvg(first!.logo)} /> Open in {first!.name}
    </a>
    <details class="pa-menu" data-menu>
      <summary class="pa-button" aria-label="More ways to read this page"><Icon name="caret-down" /></summary>
      <div class="menu">
        <p class="menu-label">Ask about this page</p>
        {
          [first!, ...rest].map((c) => (
            <a href={c.url(prompt)} target="_blank" rel="noopener">
              <span class="menu-main">
                <span class="ai-logo" set:html={logoSvg(c.logo)} />
                Open in {c.name}
              </span>
              <Icon name="arrow-up-right" />
            </a>
          ))
        }
        <p class="menu-label">Plain text</p>
        <a href={url(`docs/md/${slug}.md`)}>
          <span class="menu-main"><Icon name="markdown-logo" /> View as Markdown</span>
          <Icon name="arrow-up-right" />
        </a>
        <a href={url('llms.txt')}>
          <span class="menu-main"><Icon name="file-text" /> llms.txt</span>
          <Icon name="arrow-up-right" />
        </a>
        <a href={url('llms-full.txt')}>
          <span class="menu-main"><Icon name="file-text" /> llms-full.txt</span>
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </details>
  </div>
</div>

<script>
  // One menu open at a time, closed by a click elsewhere or Escape.
  document.addEventListener('click', (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]')) {
      if (!menu.contains(event.target as Node)) menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]').forEach((m) => (m.open = false));
  });
</script>
