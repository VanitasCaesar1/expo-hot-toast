---
/**
 * Clerk's "What did you think of this content?". There is no server to count
 * votes, so each choice does something real instead: helpful asks for a star,
 * which is how other people find the library; not helpful, and I have
 * feedback, open a GitHub issue that names the page. The library itself says
 * thank you.
 */
import Icon from '../Icon.astro';
import { REPO_URL } from '../../lib/url';

interface Props {
  title: string;
  slug: string;
}

const { title, slug } = Astro.props;
const page = `https://vanitascaesar1.github.io/expo-hot-toast/docs/${slug}`;
const issue = (kind: string, question: string) =>
  `${REPO_URL}/issues/new?title=${encodeURIComponent(`Docs (${kind}): ${title}`)}&body=${encodeURIComponent(`Page: ${page}\n\n${question}\n`)}`;
const missing = issue('not helpful', 'What were you looking for, and what was missing or unclear?');
const feedback = issue('feedback', 'What would make this page better?');
---

<section class="feedback" data-feedback data-pagefind-ignore="all">
  <p class="feedback-title">What did you think of this content?</p>
  <div class="feedback-actions">
    <button type="button" data-vote="up"><Icon name="thumbs-up" /> It was helpful</button>
    <a href={missing} target="_blank" rel="noopener" data-vote="down"><Icon name="thumbs-down" /> It was not helpful</a>
    <a href={feedback} target="_blank" rel="noopener"><Icon name="chat-teardrop-text" /> I have feedback</a>
  </div>
  <p class="feedback-thanks" data-thanks="up" hidden>
    Glad it helped. A <a href={REPO_URL} target="_blank" rel="noopener">star on GitHub</a> is how other people find it.
  </p>
  <p class="feedback-thanks" data-thanks="down" hidden>
    Thank you. The issue that just opened goes straight to the maintainer; say what was missing and the page gets fixed.
  </p>
</section>

<script>
  import { configure, withToast } from '../../lib/live';

  for (const root of document.querySelectorAll<HTMLElement>('[data-feedback]')) {
    root.querySelectorAll<HTMLElement>('[data-vote]').forEach((choice) =>
      choice.addEventListener('click', () => {
        const up = choice.dataset.vote === 'up';
        root.querySelectorAll('[data-vote]').forEach((b) => b.setAttribute('aria-pressed', String(b === choice)));
        root.querySelectorAll<HTMLElement>('[data-thanks]').forEach((t) => (t.hidden = t.dataset.thanks !== choice.dataset.vote));
        // The library itself says thank you, from the bottom, clear of the top bar.
        configure({ position: 'bottom-center' });
        withToast((toast) => (up ? toast.success('Thanks! Glad it helped.') : toast('Thanks for telling us.')));
      }),
    );
  }
</script>
