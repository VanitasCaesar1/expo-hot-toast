---
// Phosphor (UI glyphs) and Simple Icons (brand marks), inlined so they take
// the current text colour.
import copy from '@phosphor-icons/core/assets/regular/copy.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import search from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import phBookOpen from '@phosphor-icons/core/assets/regular/book-open.svg?raw';
import phCode from '@phosphor-icons/core/assets/regular/code.svg?raw';
import phCaretRight from '@phosphor-icons/core/assets/regular/caret-right.svg?raw';
import phCaretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import phSparkle from '@phosphor-icons/core/assets/regular/sparkle.svg?raw';
import phThumbsUp from '@phosphor-icons/core/assets/regular/thumbs-up.svg?raw';
import phThumbsDown from '@phosphor-icons/core/assets/regular/thumbs-down.svg?raw';
import phChatTeardropText from '@phosphor-icons/core/assets/regular/chat-teardrop-text.svg?raw';
import phX from '@phosphor-icons/core/assets/regular/x.svg?raw';
import phInfo from '@phosphor-icons/core/assets/regular/info.svg?raw';
import phLightbulb from '@phosphor-icons/core/assets/regular/lightbulb.svg?raw';
import phWarning from '@phosphor-icons/core/assets/regular/warning.svg?raw';
import phWarningCircle from '@phosphor-icons/core/assets/regular/warning-circle.svg?raw';
import phPlayCircle from '@phosphor-icons/core/assets/regular/play-circle.svg?raw';
import phStack from '@phosphor-icons/core/assets/regular/stack.svg?raw';
import phPalette from '@phosphor-icons/core/assets/regular/palette.svg?raw';
import phHandTap from '@phosphor-icons/core/assets/regular/hand-tap.svg?raw';
import phTimer from '@phosphor-icons/core/assets/regular/timer.svg?raw';
import phDeviceMobile from '@phosphor-icons/core/assets/regular/device-mobile.svg?raw';
import phAndroidLogo from '@phosphor-icons/core/assets/regular/android-logo.svg?raw';
import phAppleLogo from '@phosphor-icons/core/assets/regular/apple-logo.svg?raw';
import phGlobe from '@phosphor-icons/core/assets/regular/globe.svg?raw';
import phLightning from '@phosphor-icons/core/assets/regular/lightning.svg?raw';
import phTerminal from '@phosphor-icons/core/assets/regular/terminal.svg?raw';
import phRobot from '@phosphor-icons/core/assets/regular/robot.svg?raw';
import phMonitor from '@phosphor-icons/core/assets/regular/monitor.svg?raw';
import phSun from '@phosphor-icons/core/assets/regular/sun.svg?raw';
import phMoon from '@phosphor-icons/core/assets/regular/moon.svg?raw';
import phSquaresFour from '@phosphor-icons/core/assets/regular/squares-four.svg?raw';
import phArrowSquareOut from '@phosphor-icons/core/assets/regular/arrow-square-out.svg?raw';
import phMarkdownLogo from '@phosphor-icons/core/assets/regular/markdown-logo.svg?raw';
import phFileText from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import phChats from '@phosphor-icons/core/assets/regular/chats.svg?raw';
import phArrowsOutCardinal from '@phosphor-icons/core/assets/regular/arrows-out-cardinal.svg?raw';
import phBell from '@phosphor-icons/core/assets/regular/bell.svg?raw';
import phCursorClick from '@phosphor-icons/core/assets/regular/cursor-click.svg?raw';
import phEye from '@phosphor-icons/core/assets/regular/eye.svg?raw';
import phSwap from '@phosphor-icons/core/assets/regular/swap.svg?raw';
import phPlugs from '@phosphor-icons/core/assets/regular/plugs.svg?raw';
import { siGithub, siExpo, siReact, siApple, siAndroid } from 'simple-icons';

const brand = (path: string) => `<svg viewBox="0 0 24 24" fill="currentColor"><path d="${path}"/></svg>`;

const glyphs = {
  copy,
  check,
  search,
  plus,
  list,
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  'book-open': phBookOpen,
  'code': phCode,
  'caret-right': phCaretRight,
  'caret-down': phCaretDown,
  'sparkle': phSparkle,
  'thumbs-up': phThumbsUp,
  'thumbs-down': phThumbsDown,
  'chat-teardrop-text': phChatTeardropText,
  'x': phX,
  'info': phInfo,
  'lightbulb': phLightbulb,
  'warning': phWarning,
  'warning-circle': phWarningCircle,
  'play-circle': phPlayCircle,
  'stack': phStack,
  'palette': phPalette,
  'hand-tap': phHandTap,
  'timer': phTimer,
  'device-mobile': phDeviceMobile,
  'android-logo': phAndroidLogo,
  'apple-logo': phAppleLogo,
  'globe': phGlobe,
  'lightning': phLightning,
  'terminal': phTerminal,
  'robot': phRobot,
  'monitor': phMonitor,
  'sun': phSun,
  'moon': phMoon,
  'squares-four': phSquaresFour,
  'arrow-square-out': phArrowSquareOut,
  'markdown-logo': phMarkdownLogo,
  'file-text': phFileText,
  'chats': phChats,
  'arrows-out-cardinal': phArrowsOutCardinal,
  'bell': phBell,
  'cursor-click': phCursorClick,
  'eye': phEye,
  'swap': phSwap,
  'plugs': phPlugs,
  github: brand(siGithub.path),
  expo: brand(siExpo.path),
  react: brand(siReact.path),
  apple: brand(siApple.path),
  android: brand(siAndroid.path),
} as const;

export type IconName = keyof typeof glyphs;

interface Props {
  name: IconName;
  label?: string;
}

const { name, label } = Astro.props;
const svg = glyphs[name].replace('<svg', `<svg aria-hidden="true" focusable="false"`);
---

<span class="icon" set:html={svg} />
{label && <span class="visually-hidden">{label}</span>}

<style>
  .icon {
    display: inline-flex;
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
